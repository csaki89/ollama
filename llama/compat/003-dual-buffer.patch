+static void vk_kvc_arena_unref(vk_kvc_arena * a) {
+    int left;
+    {
+        std::lock_guard<std::mutex> lock(a->mtx);
+        left = --a->refs;
+    }
+    if (left == 0) {
+        delete a;
+    }
+}
