+// returns false if there is no limit (or no cgroup, e.g. non-Linux)
+static bool read_cgroup_u64(const std::string & path, uint64_t & val) {
+    std::ifstream f(path);
+    std::string s;
+    if (!f || !(f >> s) || s == "max") {
+        return false;
+    }
+    char * end = nullptr;
+    val = strtoull(s.c_str(), &end, 10);
+    return end != s.c_str();
