+    if (ggml_cuda_vmm_n_ranges.load(std::memory_order_relaxed) == 0) {
+        return size;
+    }
+    const uintptr_t a = (uintptr_t) p;
+    std::lock_guard<std::mutex> lock(ggml_cuda_vmm_ranges_mtx);
+    for (const auto & r : ggml_cuda_vmm_ranges) {
