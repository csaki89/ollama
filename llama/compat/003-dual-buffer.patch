+        params.zones_ovr_full.clear();
+        return;
+    }
+
+    // zone 1 + 2: load with the small-context placement; the loader puts its GPU tensors that zone 1 has on the CPU in the flex band
+    const int32_t ngl_full  = mparams.n_gpu_layers;
