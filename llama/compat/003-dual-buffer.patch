+bool llama_context::zones_reserve(uint32_t n_tokens) {
+    auto * kv = zones_kv_init > 0 ? dynamic_cast<llama_kv_cache *>(memory.get()) : nullptr;
+    if (!kv || !kv->is_dynamic()) {
+        return true;
+    }
+    // the zone step with the whole remaining prompt: the shrink or growth and the flex moves happen once, here
+    const uint32_t used = kv->used_cells();
+    const uint32_t size = kv->get_size();
+    zones_reserved = 0;
+    zones_step(n_tokens);
+    zones_reserved      = used + n_tokens;
+    zones_reserved_from = used;
+    const bool ok = kv->get_size() >= std::min(used + n_tokens, kv->dyn_max_size());
+    LLAMA_LOG_INFO("%s: KV reserved for %u + %u tokens: %u -> %u cells%s\n", __func__, used, n_tokens, size, kv->get_size(),
+        ok ? "" : " (not enough, it grows by steps)");
+    return ok;
+}
+
+void llama_context::zones_step(uint32_t n_tokens) {
+    auto * kv = zones_kv_init > 0 ? dynamic_cast<llama_kv_cache *>(memory.get()) : nullptr;
+    if (!kv || !kv->is_dynamic()) {
+        return;
+    }
+    // the previous batch must be done before buffers change; not synchronize(), that would account the queued batch in the perf stats
+    auto sync = [&]() {
+        if (sched) {
+            ggml_backend_sched_synchronize(sched.get());
+        }
+    };
+
+    // the flash attention probe has run by now: the dynamic KV needs a non-transposed V cache, not flash attention itself
+    if (!zones_fa_logged) {
+        zones_fa_logged = true;
+        if (cparams.flash_attn) {
+            LLAMA_LOG_INFO("%s: zones: flash attention on, dynamic KV on\n", __func__);
+        } else {
+            LLAMA_LOG_WARN("%s: zones: flash attention is not available on this device (auto resolved it to off): the dynamic KV stays on "
+                "(the V cache was created non-transposed), the attention runs without flash attention\n", __func__);
+        }
+    }
+
+    // zone rule (DESIGN-3zone.md 6.3): device memory budget, booked from the first step on
+    const bool rule = !model.flex_layers().empty();
+    if (rule && !zones_headroom_set) {
+        zones_headroom_set = true;
+        size_t dev_free = 0, dev_total = 0;
+        ggml_backend_dev_memory(model.flex_gpu_dev(model.flex_layers().front()), &dev_free, &dev_total);
+        zones_headroom = (int64_t) dev_free - (int64_t) zones_vram_margin;
+        if (const char * env = getenv("LLAMA_ZONES_HEADROOM_MIB")) { // test aid
+            zones_headroom = (int64_t) atoll(env) * 1024 * 1024;
+        }
+        LLAMA_LOG_INFO("%s: zones: device memory budget %.0f MiB (free %.0f MiB, margin %.0f MiB)\n", __func__,
+            zones_headroom / 1048576.0, dev_free / 1048576.0, zones_vram_margin / 1048576.0);
+    }
+
+    // a resize outside this step (state load) is booked too; over the budget, flex layers go off first
+    const uint32_t size_in = zones_kv_size != 0 ? zones_kv_size : kv->get_size();
+    int n_off = 0, n_on = 0;
+    if (rule && zones_kv_size != 0 && kv->get_size() != zones_kv_size) {
+        zones_headroom -= ((int64_t) kv->get_size() - (int64_t) zones_kv_size)*(int64_t) kv->cell_bytes(true);
+    }
+    while (rule && zones_headroom < 0) {
+        const int il = model.flex_next(false);
+        if (il < 0) {
+            break;
+        }
+        const int64_t freed = (int64_t) (model.flex_layer_bytes(il) + (model.flex_whole(il) ? kv->layer_bytes(il) : 0));
+        if (!flex_move_layer(il, false)) {
+            break;
+        }
+        zones_headroom += freed;
+        n_off++;
+    }
+
+    const uint32_t size = kv->get_size();
+    const uint32_t used = kv->used_cells();
+    bool shrunk = false;
+
+    // a reservation holds while the prompt fills it; it ends when reached, or when cells were removed (a new conversation)
+    if (zones_reserved > 0 && (used >= zones_reserved || used < zones_reserved_from)) {
+        zones_reserved = 0;
+    }
+
+    // shrink when the KV is empty or mostly unused (new conversation, removed sequences); not below a reservation
+    if (size > zones_kv_init && (used == 0 || used < size/4)) {
+        const uint32_t n = std::max(zones_kv_init, kv->dyn_round(std::max(used + n_tokens, zones_reserved)));
+        if (n < size) {
+            sync();
+            const size_t per_cell = kv->cell_bytes(true);
+            if (kv->resize(n)) {
+                zones_headroom += (int64_t) ((size - n)*per_cell);
+                shrunk = true;
+            }
+        }
+    }
+
+    // put the flex layers back, in reverse order, while the budget allows (weights + K/V at the current size);
+    // the budget is first set to what the device really has free (both ways: the freed memory is back by now)
+    if (rule && (shrunk || used == 0) && model.flex_next(true) >= 0) {
+        zones_clamp(true);
+        for (int il = model.flex_next(true); il >= 0; il = model.flex_next(true)) {
+            const int64_t cost = (int64_t) (model.flex_layer_bytes(il) + (model.flex_whole(il) ? kv->layer_bytes(il) : 0));
+            if (cost > zones_headroom) {
+                break;
+            }
+            if (!flex_move_layer(il, true)) {
+                break;
+            }
+            zones_headroom -= cost;
+            n_on++;
+        }
+    }
+
+    // grow in chunks when the next batch does not fit; take flex layers off (closest to the CPU first) to make room
+    if (used + n_tokens > kv->get_size() && kv->get_size() < kv->dyn_max_size()) {
+        sync();
+        if (rule) {
+            zones_clamp();
+        }
+        const uint32_t n = kv->dyn_round(used + n_tokens);
+        // the copy path also needs the old and the new K/V of a layer at the same time (resize_peak), the VMM path does not
+        auto need = [&]() { return (int64_t) ((n - kv->get_size())*kv->cell_bytes(true) + kv->resize_peak(n)); };
+        int64_t delta = need();
+        while (rule && delta > zones_headroom) {
+            const int il = model.flex_next(false);
+            if (il < 0) {
+                break;
+            }
+            const int64_t freed = (int64_t) (model.flex_layer_bytes(il) + (model.flex_whole(il) ? kv->layer_bytes(il) : 0));
+            if (!flex_move_layer(il, false)) {
+                break;
+            }
+            zones_headroom += freed;
+            n_off++;
+            delta = need();
+        }
+        if (rule && delta > zones_headroom) {
+            LLAMA_LOG_WARN("%s: zones: the KV grows beyond the device memory budget (%.0f MiB over), no flex layer left\n", __func__,
+                (delta - zones_headroom) / 1048576.0);
+        }
+        // the budget books the final growth (the transient peak is gone after the resize)
+        const int64_t growth = (int64_t) ((n - kv->get_size())*kv->cell_bytes(true));
+        if (kv->resize(n)) {
+            zones_headroom -= growth;
+        }
+    }
+    zones_kv_size = kv->get_size();
+
+    // the K/V tensors were reallocated (here or in a state load): new graph and scheduler reservation
+    if (kv->generation() != zones_kv_gen) {
+        zones_kv_gen       = kv->generation();
+        gf_res_prev_active = nullptr;
+        sched_need_reserve = true;
+    }
+
+    if (size_in != zones_kv_size || n_off > 0 || n_on > 0) {
+        char what[96];
+        snprintf(what, sizeof(what), "KV %u -> %u cells, %d flex layers off, %d back", size_in, zones_kv_size, n_off, n_on);
+        zones_log_state(what);
+    }
+}
+
+// the free VRAM by the kernel driver (amdgpu sysfs: mem_info_vram_total - mem_info_vram_used) of the card whose total is closest
+// to total (within 1/16); false if there is none (not Linux, not amdgpu)
+static bool zones_sysfs_free(size_t total, size_t & free_out) {
+#if defined(__linux__)
+    size_t best = SIZE_MAX;
+    for (int c = 0; c < 16; ++c) {
+        unsigned long long t = 0, u = 0;
+        const std::string base = "/sys/class/drm/card" + std::to_string(c) + "/device/mem_info_vram_";
+        FILE * ft = fopen((base + "total").c_str(), "r");
+        FILE * fu = ft ? fopen((base + "used").c_str(), "r") : nullptr;
+        const bool ok = ft && fu && fscanf(ft, "%llu", &t) == 1 && fscanf(fu, "%llu", &u) == 1 && u <= t;
+        if (fu) { fclose(fu); }
+        if (ft) { fclose(ft); }
+        const size_t diff = (size_t) (t > total ? t - total : total - t);
+        if (ok && diff <= total/16 && diff < best) {
+            best     = diff;
+            free_out = (size_t) (t - u);
+        }
+    }
+    return best != SIZE_MAX;
+#else
+    GGML_UNUSED(total);
+    GGML_UNUSED(free_out);
+    return false;
+#endif
+}
+
+ggml_backend_dev_t llama_context::zones_dev() const {
+    const auto flex = model.flex_layers();
+    if (!flex.empty()) {
+        return model.flex_gpu_dev(flex.front());
+    }
+    for (const auto & b : backends) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(b.get());
+        if (dev && ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            return dev;
+        }
+    }
+    return nullptr;
+}
+
+size_t llama_context::zones_clamp(bool up) {
+    ggml_backend_dev_t dev = zones_dev();
+    if (!dev) {
+        return 0;
+    }
+    size_t dev_free = 0, dev_total = 0;
+    ggml_backend_dev_memory(dev, &dev_free, &dev_total);
+    // the kernel's own figure where there is one: the booked free memory is checked against it, the lower one counts
+    size_t sys_free = 0;
+    const bool sys = zones_sysfs_free(dev_total, sys_free);
+    const int64_t booked = zones_headroom + (int64_t) zones_vram_margin;
+    if (sys && std::llabs(booked - (int64_t) sys_free) > (int64_t) zones_vram_margin/2) {
+        LLAMA_LOG_WARN("%s: zones: the booked free memory (%.0f MiB) is off from the device: driver %.0f MiB, sysfs %.0f MiB\n", __func__,
+            booked / 1048576.0, dev_free / 1048576.0, sys_free / 1048576.0);
+    }
+    const size_t free_real = sys ? std::min(dev_free, sys_free) : dev_free;
+    const int64_t real = (int64_t) free_real - (int64_t) zones_vram_margin;
+    if ((real < zones_headroom || (up && real > zones_headroom)) && !getenv("LLAMA_ZONES_HEADROOM_MIB")) {
+        LLAMA_LOG_INFO("%s: zones: budget %.0f -> %.0f MiB (measured free %.0f MiB: driver %.0f, sysfs %s; margin %.0f MiB)\n", __func__,
+            zones_headroom / 1048576.0, real / 1048576.0, free_real / 1048576.0, dev_free / 1048576.0,
+            sys ? std::to_string(sys_free >> 20).c_str() : "-", zones_vram_margin / 1048576.0);
+        zones_headroom = real;
+    }
+    return free_real;
+}
+
+void llama_context::zones_log_state(const char * what) {
+    auto * kv = dynamic_cast<llama_kv_cache *>(memory.get());
+    size_t w_gpu = 0;
+    for (const auto & [buft, size] : model.memory_breakdown()) {
+        ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+        if (dev && ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU && !ggml_backend_buft_is_host(buft)) {
+            w_gpu += size;
+        }
+    }
+    const size_t w_all = std::max(model.size(), w_gpu);
+
+    // the flex layers that are off, as ranges
+    const auto flex = model.flex_layers();
+    std::string off;
+    int n_flex_on = 0;
+    for (size_t i = 0; i < flex.size(); ++i) {
+        if (model.flex_on_gpu(flex[i])) {
+            n_flex_on++;
+            continue;
+        }
+        size_t j = i;
+        while (j + 1 < flex.size() && !model.flex_on_gpu(flex[j + 1]) && flex[j + 1] == flex[j] + 1) {
+            j++;
+        }
+        off += (off.empty() ? "" : ",") + std::to_string(flex[i]) + (j > i ? "-" + std::to_string(flex[j]) : "");
+        i = j;
+    }
+
+    size_t dev_free = 0, dev_total = 0;
+    if (ggml_backend_dev_t dev = zones_dev()) {
+        ggml_backend_dev_memory(dev, &dev_free, &dev_total);
+    }
+    size_t sys_free = 0;
+    const bool sys = zones_sysfs_free(dev_total, sys_free);
+    LLAMA_LOG_INFO("%s: zones_state (%s): weights GPU %.0f MiB (%.0f%%), CPU %.0f MiB; flex %d/%zu layers on the GPU%s%s; "
+        "KV %u cells (%u used, %.0f MiB on the device); device free: booked %.0f, driver %.0f, sysfs %s MiB (budget %.0f MiB, margin %.0f MiB)\n",
+        __func__, what,
+        w_gpu / 1048576.0, w_all > 0 ? 100.0*w_gpu/w_all : 0.0, (w_all - w_gpu) / 1048576.0, n_flex_on, flex.size(),
+        off.empty() ? "" : ", off: ", off.c_str(), kv ? kv->get_size() : 0, kv ? kv->used_cells() : 0,
+        kv ? kv->get_size()*kv->cell_bytes(true) / 1048576.0 : 0.0, (zones_headroom + (int64_t) zones_vram_margin) / 1048576.0,
+        dev_free / 1048576.0, sys ? std::to_string(sys_free >> 20).c_str() : "-", zones_headroom / 1048576.0,
+        zones_vram_margin / 1048576.0);
+}
+
+bool llama_context::flex_move_layer(int il, bool to_gpu) {
+    // the previous batch must be done; not synchronize(), that would account the queued batch in the perf stats
+    if (sched) {
+        ggml_backend_sched_synchronize(sched.get());
+    }
+    // the GPU backend of the layer, for asynchronous (DMA) copies
+    ggml_backend_t backend_gpu = nullptr;
+    if (!flex_test_copy_legacy) {
+        for (auto & b : backends) {
+            if (ggml_backend_get_device(b.get()) == model.flex_gpu_dev(il)) {
+                backend_gpu = b.get();
+            }
+        }
+    }
+    if (!model.flex_move(il, to_gpu, flex_test_file)) {
+        return false;
+    }
+    if (sched) {
+        flex_set_alts(il);
+    }
+    // the layer's K/V follows the weights (LLAMA_FLEX_TEST_KV=0 keeps it in place, for comparison)
+    if (flex_test_kv && model.flex_whole(il)) {
+        if (auto * kv = dynamic_cast<llama_kv_cache *>(memory.get())) {
+            kv->flex_move(il, to_gpu, backend_gpu, flex_test_copy_legacy);
+        } else {
+            LLAMA_LOG_WARN("%s: flex: this memory type does not support moving the K/V, it stays in place\n", __func__);
+        }
+    }
+    // the weight placement changed: build the next graph again
+    gf_res_prev_active = nullptr;
+    return true;
+}
