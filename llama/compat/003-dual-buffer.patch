+std::vector<int> llama_model::flex_layers() const {
+    std::vector<int> res;
+    for (const auto & [il, fl] : pimpl->flex) {
+        if (fl.buf_idx != SIZE_MAX && !fl.park_only) {
+            res.push_back(il);
+        }
+    }
+    return res;
+}
