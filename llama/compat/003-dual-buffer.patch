+bool llama_model::park_available() const {
+    for (const auto & [il, fl] : pimpl->flex) {
+        if (fl.park_only && fl.buf_idx != SIZE_MAX) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool llama_model::park_move(bool to_gpu, size_t * bytes) const {
+    // park: every group (flex layers and park copies) off the device, the placement before it is kept; unpark: back to it
+    // (the park copies are host buffers: the upload is a DMA from pinned memory)
+    size_t moved = 0;
+    bool ok = true;
+    if (!to_gpu) {
+        pimpl->park_prev.clear();
+    }
+    pimpl->park_quiet = true;
+    for (auto & [il, fl] : pimpl->flex) {
+        if (fl.buf_idx == SIZE_MAX) {
+            continue;
+        }
+        const bool has_exps = fl.buf_idx_exps != SIZE_MAX;
+        if (!to_gpu) {
+            pimpl->park_prev[il] = { fl.on_gpu, fl.exps_on_gpu };
+            if (has_exps && fl.exps_on_gpu) {
+                moved += flex_layer_bytes(il, LLAMA_FLEX_EXPS);
+                ok = flex_move_part(il, true, false, false) && ok;
+            }
+            if (fl.on_gpu) {
+                moved += flex_layer_bytes(il, has_exps ? LLAMA_FLEX_REST : LLAMA_FLEX_ALL);
+                ok = flex_move_part(il, false, false, false) && ok;
+            }
+        } else {
+            const auto it = pimpl->park_prev.find(il);
+            const bool rest = it == pimpl->park_prev.end() || it->second.first;
+            const bool exps = it == pimpl->park_prev.end() || it->second.second;
+            if (rest && !fl.on_gpu) {
+                moved += flex_layer_bytes(il, has_exps ? LLAMA_FLEX_REST : LLAMA_FLEX_ALL);
+                ok = flex_move_part(il, false, true, false) && ok;
+            }
+            if (has_exps && exps && !fl.exps_on_gpu) {
+                moved += flex_layer_bytes(il, LLAMA_FLEX_EXPS);
+                ok = flex_move_part(il, true, true, false) && ok;
+            }
+        }
+    }
+    pimpl->park_quiet = false;
+    if (bytes) {
+        *bytes = moved;
+    }
+    return ok;
+}
+
+size_t llama_model::park_demoted_bytes() const {
+    size_t res = 0;
+    for (const auto & [il, fl] : pimpl->flex) {
+        res += fl.demoted ? fl.demote_bytes : 0;
+    }
+    return res;
+}
+
+size_t llama_model::park_demote() const {
+    // what the demote needs: the repackable weights of the parked groups not demoted yet
+    size_t need = 0;
+    for (const auto & [il, fl] : pimpl->flex) {
+        if (fl.park_only && !fl.on_gpu && !fl.demoted) {
+            for (const auto & p : fl.pairs) {
+                need += p.demote_buft ? ggml_nbytes(p.gpu) : 0;
+            }
+        }
+    }
+    if (need == 0) {
+        return 0;
+    }
+    // the RAM guard: the free RAM (cgroup limit if any) minus a reserve
+    size_t ram_free = 0, ram_total = 0, cg_free = 0, cg_limit = 0;
+    const char * src = "system";
+    if (ggml_backend_dev_t cpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU)) {
+        ggml_backend_dev_memory(cpu, &ram_free, &ram_total);
+    }
+    if (get_cgroup_free(cg_free, cg_limit)) {
+        const size_t unch = ram_uncharged_all();
+        ram_free  = cg_free > unch ? cg_free - unch : 0;
+        ram_total = cg_limit;
+        src       = unch > 0 ? "cgroup limit + uncharged driver host memory" : "cgroup limit";
+    }
+    if (const char * env = getenv("LLAMA_DUAL_BUFFER_FREE_MIB")) { // test aid
+        ram_free  = (size_t) atoll(env) * 1024 * 1024;
+        ram_total = std::max(ram_total, ram_free);
+        src       = "env override";
+    }
+    const size_t reserve = std::max((size_t) 1 << 30, ram_total / 20);
+    if (ram_total > 0 && ram_free < need + reserve) {
+        LLAMA_LOG_WARN("%s: park: no demote, the repacked copies (%.0f MiB) do not fit the free RAM (%.0f MiB, %s, reserve %.0f MiB); the CPU computes from the pinned copies\n",
+            __func__, need / 1048576.0, ram_free / 1048576.0, src, reserve / 1048576.0);
+        return 0;
+    }
+    const int64_t t0 = ggml_time_us();
+    size_t done = 0;
+    for (auto & [il, fl] : pimpl->flex) {
+        if (!fl.park_only || fl.on_gpu || fl.demoted) {
+            continue;
+        }
+        std::map<ggml_backend_buffer_type_t, std::vector<llama_model_loader::flex_pair *>> by_buft;
+        for (auto & p : fl.pairs) {
+            if (p.demote_buft && !p.host) {
+                by_buft[p.demote_buft].push_back(&p);
+            }
+        }
+        for (auto & [buft, ps] : by_buft) {
+            ggml_init_params ip = { ggml_tensor_overhead()*(ps.size() + 1), nullptr, true };
+            ggml_context_ptr ctx(ggml_init(ip));
+            std::vector<ggml_tensor *> reps;
+            for (auto * p : ps) {
+                ggml_tensor * r = ggml_dup_tensor(ctx.get(), p->gpu);
+                ggml_set_name(r, ggml_get_name(p->gpu));
+                reps.push_back(r);
+            }
+            ggml_backend_buffer_ptr buf(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft));
+            if (!buf) {
+                LLAMA_LOG_WARN("%s: park: allocating %s for the demote failed, the CPU computes from the pinned copies\n", __func__, ggml_backend_buft_name(buft));
+                continue;
+            }
+            ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+            for (size_t i = 0; i < ps.size(); ++i) {
+                auto * p = ps[i];
+                // the model tensor holds the pinned copy while parked: the repack buffer converts it on the set
+                ggml_backend_tensor_set(reps[i], p->gpu->data, 0, ggml_nbytes(p->gpu));
+                flex_swap_storage(p->gpu, reps[i]); // the model computes from the repacked copy
+                p->host = reps[i];                  // the pinned copy: the source of the upload on the unpark
+                fl.demote_bytes += ggml_nbytes(p->gpu);
+                done += ggml_nbytes(p->gpu);
+            }
+            fl.demote_ctxs.push_back(std::move(ctx));
+            fl.demote_bufs.push_back(std::move(buf));
+        }
+        fl.demoted = !fl.demote_bufs.empty();
+    }
+    LLAMA_LOG_INFO("%s: park: demoted %.2f MiB (repacked for the CPU from the pinned copies) in %.1f ms; kept until dropped\n",
+        __func__, done / 1048576.0, (ggml_time_us() - t0) / 1000.0);
+    return done;
+}
+
+size_t llama_model::park_drop_demoted() const {
+    size_t freed = 0;
+    for (auto & [il, fl] : pimpl->flex) {
+        if (!fl.demoted) {
+            continue;
+        }
+        for (auto & p : fl.pairs) {
+            if (!p.host || !p.park) {
+                continue;
+            }
+            // the pinned copy goes back where it was: the model tensor (parked) or the twin (unparked)
+            flex_swap_storage(fl.on_gpu ? p.cpu : p.gpu, p.host);
+            p.host = nullptr;
+        }
+        freed += fl.demote_bytes;
+        fl.demote_bytes = 0;
+        fl.demote_bufs.clear();
+        fl.demote_ctxs.clear();
+        fl.demoted = false;
+    }
+    if (freed > 0) {
+        LLAMA_LOG_INFO("%s: park: the demoted (repacked) copies were dropped (%.2f MiB)\n", __func__, freed / 1048576.0);
+    }
+    return freed;
+}
+
+bool llama_model::park_was_on_gpu(int il) const {
+    const auto it = pimpl->park_prev.find(il);
+    return it == pimpl->park_prev.end() || it->second.first;
+}
+
+bool llama_model::flex_move(int il, bool to_gpu, bool from_file, int part) const {
+    auto it = pimpl->flex.find(il);
+    if (it == pimpl->flex.end() || it->second.buf_idx == SIZE_MAX) {
+        LLAMA_LOG_WARN("%s: layer %d is not a flex layer\n", __func__, il);
+        return false;
+    }
+    const bool has_exps = it->second.buf_idx_exps != SIZE_MAX;
+    if (part == LLAMA_FLEX_EXPS) {
+        return !has_exps || flex_move_part(il, true, to_gpu, from_file);
+    }
+    if (part == LLAMA_FLEX_REST || !has_exps) {
+        return flex_move_part(il, false, to_gpu, from_file);
+    }
+    // the whole layer: the experts leave first and come back last
+    return to_gpu ? flex_move_part(il, false, true, from_file) && flex_move_part(il, true, true, from_file)
+                  : flex_move_part(il, true, false, from_file) && flex_move_part(il, false, false, from_file);
+}
+
+bool llama_model::flex_move_part(int il, bool exps, bool to_gpu, bool from_file) const {
+    auto & fl = pimpl->flex.at(il);
+    bool & on_gpu = exps ? fl.exps_on_gpu : fl.on_gpu;
+    if (on_gpu == to_gpu) {
+        return true;
+    }
+    std::vector<llama_model_loader::flex_pair *> pairs;
+    for (auto & p : fl.pairs) {
+        if (p.exps == exps) {
+            pairs.push_back(&p);
+        }
+    }
+    if (pairs.empty()) {
+        on_gpu = to_gpu;
+        return true;
+    }
+
+    const int64_t t0 = ggml_time_us();
+    int64_t t_alloc = 0, t_copy = 0, t_free = 0;
+    auto & bufs = pimpl->ctxs_bufs[exps ? fl.buf_idx_exps : fl.buf_idx].second;
+    ggml_backend_buffer_type_t buft = pairs[0]->buft;
+    size_t nbytes = 0;
+    int n_host = 0, n_cpu = 0, n_file = 0;
+
+    if (!to_gpu) {
+        // the model tensors take the CPU storage, then the GPU buffer is freed
+        for (auto * p : pairs) {
+            flex_swap_storage(p->gpu, p->cpu);
+            nbytes += ggml_nbytes(p->gpu);
+        }
+        const int64_t t1 = ggml_time_us();
+        bufs.clear();
+        t_free = ggml_time_us() - t1;
+        for (auto * p : pairs) {
+            p->cpu->buffer = nullptr;
+            p->cpu->data   = nullptr;
+            p->cpu->extra  = nullptr;
+        }
+    } else {
+        // new GPU buffer for the twins, then swap back
+        // data source: the host copy (zone 2), else the CPU copy if it is host-readable (not repacked), else the model file
+        const size_t align = ggml_backend_buft_get_alignment(buft);
+        size_t size = 0;
+        for (auto * p : pairs) {
+            size += GGML_PAD(ggml_backend_buft_get_alloc_size(buft, p->cpu), align);
+        }
+        const int64_t t1 = ggml_time_us();
+        ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(buft, size);
+        if (!buf) {
+            LLAMA_LOG_ERROR("%s: layer %d: failed to allocate %zu bytes in %s\n", __func__, il, size, ggml_backend_buft_name(buft));
+            return false;
+        }
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        ggml_tallocr talloc = ggml_tallocr_new(buf);
+        for (auto * p : pairs) {
+            ggml_tallocr_alloc(&talloc, p->cpu);
+        }
+        t_alloc = ggml_time_us() - t1;
+
+        const int64_t t2 = ggml_time_us();
+        std::vector<uint8_t> tmp;
+        for (auto * p : pairs) {
+            const size_t n = ggml_nbytes(p->cpu);
+            // p->gpu holds the CPU storage while the layer is off
+            // a synchronous set: the backend picks its path (DMA from pinned memory, or a direct write on UMA), see DECISIONS.md 19
+            const void * src = nullptr;
+            if (!from_file && p->host) {
+                src = p->host->data;
+                n_host++;
+            } else if (!from_file && ggml_backend_buffer_is_host(p->gpu->buffer)) {
+                src = p->gpu->data;
+                n_cpu++;
+            }
+            if (src) {
+                ggml_backend_tensor_set(p->cpu, src, 0, n);
+            } else {
+                tmp.resize(n);
+                auto & file = pimpl->flex_files.at(p->file_idx);
+                file->seek(p->offs, SEEK_SET);
+                file->read_raw(tmp.data(), n);
+                ggml_backend_tensor_set(p->cpu, tmp.data(), 0, n);
+                n_file++;
+            }
+            nbytes += n;
+        }
+        for (auto * p : pairs) {
+            flex_swap_storage(p->gpu, p->cpu);
+        }
+        t_copy = ggml_time_us() - t2;
+        bufs.emplace_back(buf);
+    }
+    on_gpu = to_gpu;
+    const double t_ms = (ggml_time_us() - t0) / 1000.0;
+
+    if (fl.park_only || pimpl->park_quiet) {
+        // llama_park moves every group at once and logs one summary
+        return true;
+    }
+    size_t dev_free = 0, dev_total = 0;
+    if (auto * dev = ggml_backend_buft_get_device(buft)) {
