+// growable device buffers (llama.cpp dynamic KV), the pattern tested on ROCm (ROADMAP.md, VMM test):
+// one large reserved address range per device ("arena") for the whole KV, every K and V tensor has its own section in it,
+// sized for the max context; physical memory is mapped into a section in chunks (aligned to max(recommended granularity, 2 MiB),
+// at most 256 MiB each) and zeroed synchronously right after mapping, before any other access.
+// The VRAM goes back when the arena (the address range) is freed, after the last of its buffers: on ROCm the memory of an
+// unmapped chunk is only reused in the same address range.
+// HIP has the VMM functions in the runtime, CUDA needs the driver API (GGML_USE_VMM)
+#if defined(GGML_USE_VMM) || defined(GGML_USE_HIP)
+#define GGML_CUDA_GROWABLE_BUFFER
+#include <chrono>
+#include <thread>
+#if defined(GGML_USE_HIP)
+#define GGML_CUDA_VMM_OK(x) ((x) == hipSuccess)
+#ifndef CU_MEM_ALLOC_GRANULARITY_MINIMUM
+#define CU_MEM_ALLOC_GRANULARITY_MINIMUM hipMemAllocationGranularityMinimum
+#endif
+#else
+#define GGML_CUDA_VMM_OK(x) ((x) == CUDA_SUCCESS)
+#endif
+
+// GGML_CUDA_VMM_DEBUG=1: log every reservation, mapping, access setting, zeroing, growth and release
+static bool ggml_cuda_vmm_debug() {
+    static const bool debug = getenv("GGML_CUDA_VMM_DEBUG") && atoi(getenv("GGML_CUDA_VMM_DEBUG")) != 0;
+    return debug;
+}
+#define GGML_CUDA_VMM_LOG(...) do { if (ggml_cuda_vmm_debug()) { GGML_LOG_INFO(__VA_ARGS__); } } while (0)
+
+// A mapping is not usable when hipMemSetAccess returns: on ROCm it is an amdgpu GEM_VA ioctl, which queues the page table update
+// on the VM's delayed entity and does not wait for it (the first access faults, depending on the timing). A KFD mapping waits for
+// its own update on the same entity (FIFO) and flushes the TLB, so mapping a fresh allocation larger than the ROCr 2 MiB
+// suballocation block is a barrier for all the updates queued before it (NAS: 0.2-0.4 ms; a blind wait is not reliable).
+// GGML_CUDA_VMM_SYNC=auto|barrier|wait|both|none (auto: barrier on HIP, none on CUDA); wait and both are for debugging only,
+// with GGML_CUDA_VMM_WAIT_MS (default 5). Without the barrier allocation the commit fails and the caller falls back to a copy.
+struct ggml_cuda_vmm_sync_mode {
+    bool barrier;
+    int  wait_ms;
+};
+
+static const ggml_cuda_vmm_sync_mode & ggml_cuda_vmm_sync() {
+    static const ggml_cuda_vmm_sync_mode mode = []() {
+#if defined(GGML_USE_HIP)
+        const bool is_hip = true;
+#else
+        const bool is_hip = false;
+#endif
+        const char * env_sync = getenv("GGML_CUDA_VMM_SYNC");
+        const char * env_wait = getenv("GGML_CUDA_VMM_WAIT_MS");
+        const std::string s = env_sync ? env_sync : "auto";
+        const int    wait   = env_wait ? atoi(env_wait) : 5;
+        ggml_cuda_vmm_sync_mode m = { s == "both" || s == "barrier" || (s == "auto" && is_hip), s == "both" || s == "wait" ? wait : 0 };
+        GGML_LOG_INFO("ggml_cuda_vmm_sync: after mapping: GGML_CUDA_VMM_SYNC=%s: KFD barrier %s, wait %d ms\n", s.c_str(), m.barrier ? "on" : "off", m.wait_ms);
+        return m;
+    }();
+    return mode;
+}
+
+static constexpr size_t GGML_CUDA_VMM_MIN_ALIGN = 2ull << 20; // 2 MiB: section alignment
+
+// Every mapping of an arena is one chunk of the same size: the ROCm hipMemSetAccess checks its size against the sizes of the
+// first mappings of the whole address range (clr hip_vm.cpp), so a chunk after a larger first mapping fails (hipErrorInvalidValue).
+// The chunk is chosen at runtime from the granularities, the section alignment and the booking unit of the driver, measured at the
+// first arena (ggml_cuda_vmm_booking_unit; the amdgpu KFD books every allocation rounded to 2 MiB in its free memory, so smaller
+// chunks would count double in hipMemGetInfo); GGML_CUDA_VMM_CHUNK_KIB overrides it.
+
+struct ggml_cuda_vmm_arena {
+    ggml_backend_buffer_type_t buft;
+    int         device;
+    int         physical_device;
+    CUdeviceptr base     = 0;
+    size_t      reserved = 0;
+    size_t      align    = 0;
+    int         refs     = 1; // the creator and every buffer in it
+    std::vector<std::pair<CUdeviceptr, size_t>> pending; // mapped chunks not committed yet (not to be accessed)
+    int64_t     t_mapped = 0; // end of the last mapping (us)
+    size_t      chunk    = 0; // size of every mapping
+};
+
+// counters: live arenas, mapped bytes; of the last commit: mapping end -> first access (us), of which the sync (us)
+static std::atomic<int64_t> ggml_cuda_vmm_stat[4];
+
+static void ggml_cuda_vmm_arena_unref(ggml_cuda_vmm_arena * arena) {
+    if (--arena->refs > 0) {
+        return;
+    }
+    ggml_cuda_set_device(arena->device);
+    (void) cudaDeviceSynchronize();
+    const auto r_free = cuMemAddressFree(arena->base, arena->reserved);
+    const int64_t left = --ggml_cuda_vmm_stat[0];
+    GGML_CUDA_VMM_LOG("%s: address free %p, %zu bytes: %d (arenas left: %lld, mapped bytes left: %lld)\n", __func__, (void *) arena->base, arena->reserved,
+        (int) r_free, (long long) left, (long long) ggml_cuda_vmm_stat[1].load());
+    delete arena;
+}
+
+struct ggml_backend_cuda_growable_buffer_context : ggml_backend_cuda_buffer_context {
+    struct mapping {
+        CUdeviceptr ptr;
+        size_t      size;
+        CUmemGenericAllocationHandle handle;
+    };
+
+    ggml_cuda_vmm_arena * arena;
+    CUdeviceptr base;    // start of the section
+    size_t      section; // size of the section
+    size_t      mapped = 0;
+    std::vector<mapping> mappings;
+
+    ggml_backend_cuda_growable_buffer_context(ggml_cuda_vmm_arena * arena, CUdeviceptr base, size_t section) :
+        ggml_backend_cuda_buffer_context(arena->device, (void *) base), arena(arena), base(base), section(section) {
+        arena->refs++;
+    }
+
+    ~ggml_backend_cuda_growable_buffer_context() override {
+        // each mapping on its own (ROCR-Runtime issue 285), its handle only after the unmap; the address range goes with the arena
+        // no stream may use a chunk when it is unmapped
+        ggml_cuda_set_device(device);
+        (void) cudaDeviceSynchronize();
+        auto & pending = arena->pending;
+        for (auto & m : mappings) {
+            pending.erase(std::remove_if(pending.begin(), pending.end(), [&](const auto & p) { return p.first == m.ptr; }), pending.end());
+        }
+        for (auto & m : mappings) {
+            const auto r_unmap   = cuMemUnmap(m.ptr, m.size);
+            const auto r_release = cuMemRelease(m.handle);
+            ggml_cuda_vmm_stat[1] -= (int64_t) m.size;
+            if (!GGML_CUDA_VMM_OK(r_unmap) || !GGML_CUDA_VMM_OK(r_release)) {
+                GGML_LOG_ERROR("%s: unmap %p + %zu: %d, release: %d\n", __func__, (void *) m.ptr, m.size, (int) r_unmap, (int) r_release);
+                (void) cudaGetLastError();
+            }
+            GGML_CUDA_VMM_LOG("%s: unmap %p + %zu: %d, release: %d\n", __func__, (void *) m.ptr, m.size, (int) r_unmap, (int) r_release);
+        }
+        ggml_cuda_vmm_arena_unref(arena);
+        dev_ptr = nullptr; // not from cudaMalloc
+    }
+
+    // map whole chunks after the mapped ones until size is covered; they must not be accessed before ggml_cuda_vmm_commit
+    bool map_to(size_t size) {
+        const size_t chunk = arena->chunk;
+        const size_t need  = chunk * ((size + chunk - 1) / chunk);
+        if (need > section) {
+            GGML_LOG_ERROR("%s: %zu bytes do not fit the section (%zu)\n", __func__, size, section);
+            return false;
+        }
+        while (mapped < need) {
+            CUmemAllocationProp prop = {};
+            prop.type          = CU_MEM_ALLOCATION_TYPE_PINNED;
+            prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+            prop.location.id   = arena->physical_device;
+            CUmemGenericAllocationHandle handle;
+            const auto r_create = cuMemCreate(&handle, chunk, &prop, 0);
+            GGML_CUDA_VMM_LOG("%s: create %zu bytes on device %d: %d\n", __func__, chunk, arena->physical_device, (int) r_create);
+            if (!GGML_CUDA_VMM_OK(r_create)) {
+                GGML_LOG_ERROR("%s: create %zu bytes failed (%d)\n", __func__, chunk, (int) r_create);
+                return false;
+            }
+            const CUdeviceptr ptr = (CUdeviceptr) ((char *) base + mapped);
+            const auto r_map = cuMemMap(ptr, chunk, 0, handle, 0);
+            GGML_CUDA_VMM_LOG("%s: map %p + %zu (section offset %zu of %zu, arena offset %zu of %zu): %d\n", __func__, (void *) ptr, chunk,
+                mapped, section, (size_t) ((char *) ptr - (char *) arena->base), arena->reserved, (int) r_map);
+            if (!GGML_CUDA_VMM_OK(r_map)) {
+                GGML_LOG_ERROR("%s: map %p + %zu failed (%d)\n", __func__, (void *) ptr, chunk, (int) r_map);
+                (void) cuMemRelease(handle);
+                return false;
+            }
+            CUmemAccessDesc access = {};
+            access.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+            access.location.id   = arena->physical_device;
+            access.flags         = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+            const auto r_access = cuMemSetAccess(ptr, chunk, &access, 1);
+            GGML_CUDA_VMM_LOG("%s: set access %p + %zu read/write for device %d: %d\n", __func__, (void *) ptr, chunk, arena->physical_device, (int) r_access);
+            if (!GGML_CUDA_VMM_OK(r_access)) {
+                GGML_LOG_ERROR("%s: set access %p + %zu failed (%d)\n", __func__, (void *) ptr, chunk, (int) r_access);
+                (void) cuMemUnmap(ptr, chunk);
+                (void) cuMemRelease(handle);
+                return false;
+            }
+            mappings.push_back({ ptr, chunk, handle });
+            mapped += chunk;
+            ggml_cuda_vmm_stat[1] += (int64_t) chunk;
+
+            arena->pending.push_back({ ptr, chunk });
+            arena->t_mapped = ggml_time_us();
+        }
+        return true;
+    }
+};
+
+// wait until the pending mappings of the arena are valid, then zero them synchronously (their first access)
+static bool ggml_cuda_vmm_commit(ggml_cuda_vmm_arena * arena) {
+    if (arena->pending.empty()) {
+        return true;
+    }
+    ggml_cuda_set_device(arena->device);
+    const ggml_cuda_vmm_sync_mode & mode = ggml_cuda_vmm_sync();
+    const int64_t t0 = ggml_time_us();
+    // the barrier block is freed only after the sync at the end: cudaFree synchronizes the device, which is idle by then
+    void * barrier = nullptr;
+    if (mode.barrier) {
+        const cudaError_t r_barrier = cudaMalloc(&barrier, 4ull << 20);
+        if (r_barrier != cudaSuccess) {
+            (void) cudaGetLastError();
+            GGML_LOG_ERROR("%s: the KFD barrier allocation failed (%d, device memory full?): %zu new mappings not committed, "
+                "the caller falls back to a copy\n", __func__, (int) r_barrier, arena->pending.size());
+            return false;
+        }
+    }
+    if (mode.wait_ms > 0) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(mode.wait_ms));
+    }
+    const int64_t t1 = ggml_time_us();
+    ggml_cuda_vmm_stat[2] = t1 - arena->t_mapped;
+    ggml_cuda_vmm_stat[3] = t1 - t0;
+    size_t bytes = 0;
+    for (const auto & p : arena->pending) {
+        const cudaError_t r_zero = cudaMemset((void *) p.first, 0, p.second);
+        GGML_CUDA_VMM_LOG("%s: zero %p + %zu: %d\n", __func__, (void *) p.first, p.second, (int) r_zero);
+        if (r_zero != cudaSuccess) {
+            (void) cudaDeviceSynchronize();
+            (void) cudaFree(barrier);
+            return false;
+        }
+        bytes += p.second;
+    }
+    const cudaError_t r_sync = cudaDeviceSynchronize();
+    const int64_t t2 = ggml_time_us();
+    (void) cudaFree(barrier);
+    GGML_CUDA_VMM_LOG("%s: %zu chunks, %zu bytes: wait for the mappings %.2f ms (barrier %s, wait %d ms), zeroing %.2f ms, sync: %d, barrier free %.2f ms\n",
+        __func__, arena->pending.size(), bytes, (t1 - t0) / 1000.0, barrier ? "done" : "off", mode.wait_ms, (t2 - t1) / 1000.0, (int) r_sync,
+        (ggml_time_us() - t2) / 1000.0);
+    arena->pending.clear();
+    return r_sync == cudaSuccess;
+}
+
+static bool ggml_backend_cuda_vmm_arena_commit(void * arena) {
+    return ggml_cuda_vmm_commit((ggml_cuda_vmm_arena *) arena);
+}
+
+// the unit the driver books a device allocation with in its free memory (amdgpu KFD: 2 MiB, more than the granularity), measured
+// once per device: the free memory before and after a minimal handle, twice; 0 if unclear (the probes differ, nothing booked)
+static size_t ggml_cuda_vmm_booking_unit(int device, const CUmemAllocationProp & prop, size_t gran_min) {
+    static std::mutex mtx;
+    static size_t unit[GGML_CUDA_MAX_DEVICES] = {};
+    static bool   done[GGML_CUDA_MAX_DEVICES] = {};
+    std::lock_guard<std::mutex> lock(mtx);
+    if (done[device]) {
+        return unit[device];
+    }
+    done[device] = true;
+    const size_t size = std::max<size_t>(gran_min, 1);
+    size_t d[2] = { 0, 1 };
+    for (int i = 0; i < 2; ++i) {
+        size_t f0 = 0, f1 = 0, total = 0;
+        CUmemGenericAllocationHandle h;
+        if (cudaMemGetInfo(&f0, &total) != cudaSuccess || !GGML_CUDA_VMM_OK(cuMemCreate(&h, size, &prop, 0))) {
+            (void) cudaGetLastError();
+            return 0;
+        }
+        const cudaError_t r = cudaMemGetInfo(&f1, &total);
+        (void) cuMemRelease(h);
+        if (r != cudaSuccess) {
+            (void) cudaGetLastError();
+            return 0;
+        }
+        d[i] = f0 > f1 ? f0 - f1 : 0;
+    }
+    if (d[0] > 0 && d[0] == d[1] && d[0] % size == 0) {
+        unit[device] = d[0];
+    }
+    return unit[device];
+}
+
+// a new arena of size bytes on the device of buft; NULL if the device has no VMM (the caller falls back)
+static void * ggml_backend_cuda_vmm_arena_new(ggml_backend_buffer_type_t buft, size_t size) {
+    if (buft->iface.get_name != ggml_backend_cuda_buffer_type_get_name) {
+        return nullptr;
+    }
+    ggml_backend_cuda_buffer_type_context * buft_ctx = (ggml_backend_cuda_buffer_type_context *) buft->context;
+    const int device   = buft_ctx->device;
+    const int physical = ggml_cuda_get_physical_device(device);
+    ggml_cuda_set_device(device);
+
+    CUdevice cu_dev;
+    int vmm = 0;
+    if (!GGML_CUDA_VMM_OK(cuDeviceGet(&cu_dev, physical)) ||
+        !GGML_CUDA_VMM_OK(cuDeviceGetAttribute(&vmm, CU_DEVICE_ATTRIBUTE_VIRTUAL_MEMORY_MANAGEMENT_SUPPORTED, cu_dev)) || !vmm) {
+        GGML_CUDA_VMM_LOG("%s: device %d: no VMM support\n", __func__, device);
+        return nullptr;
+    }
+    CUmemAllocationProp prop = {};
+    prop.type          = CU_MEM_ALLOCATION_TYPE_PINNED;
+    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    prop.location.id   = physical;
+    size_t gran_rec = 0;
+    size_t gran_min = 0;
+    if (!GGML_CUDA_VMM_OK(cuMemGetAllocationGranularity(&gran_rec, &prop, CU_MEM_ALLOC_GRANULARITY_RECOMMENDED)) ||
+        !GGML_CUDA_VMM_OK(cuMemGetAllocationGranularity(&gran_min, &prop, CU_MEM_ALLOC_GRANULARITY_MINIMUM))) {
+        return nullptr;
+    }
+    size_t align = std::max(gran_rec, GGML_CUDA_VMM_MIN_ALIGN);
+    if (gran_min > 0) {
+        align = gran_min * ((align + gran_min - 1) / gran_min);
+    }
+    // the chunk: a common multiple of every known bound, the granularities, the section alignment and the unit the driver books an
+    // allocation with in its free memory (measured, the API does not give it); not below the alignment (more mappings per step)
+    // (at most 32 alignments: the KV reserves 64 MiB of address space per section for the alignment)
+    const size_t unit = ggml_cuda_vmm_booking_unit(device, prop, gran_min);
+    size_t chunk = align;
+    if (unit > 0 && std::lcm(align, unit) <= 32*align) {
+        chunk = std::lcm(align, unit);
+    }
+    const char * env_chunk = getenv("GGML_CUDA_VMM_CHUNK_KIB");
+    if (env_chunk && atoll(env_chunk) > 0) {
+        chunk = (size_t) atoll(env_chunk) << 10;
+        if (gran_min > 0) {
+            chunk = gran_min * std::max<size_t>(1, (chunk + gran_min - 1) / gran_min);
+        }
+        if (align % chunk != 0 && chunk % align != 0) {
+            chunk = align;
+        }
+    }
+    align = std::max(align, chunk); // the sections start on chunk boundaries
+    {
+        static bool logged[GGML_CUDA_MAX_DEVICES] = {};
+        if (!logged[device]) {
+            logged[device] = true;
+            GGML_LOG_INFO("%s: device %d: VMM granularity minimum %zu, recommended %zu; section alignment %zu; driver booking unit %zu%s; chunk %zu%s\n",
+                __func__, device, gran_min, gran_rec, align, unit,
+                unit > 0 ? " (measured)" : " (unclear: the largest known bound is used)", chunk, env_chunk ? " (GGML_CUDA_VMM_CHUNK_KIB)" : "");
+        }
+    }
+    const size_t reserved = align * ((std::max<size_t>(size, 1) + align - 1) / align);
+    CUdeviceptr base = 0;
+    const auto r_reserve = cuMemAddressReserve(&base, reserved, align, 0, 0);
+    GGML_CUDA_VMM_LOG("%s: device %d (physical %d): reserve %zu bytes at %p (granularity recommended %zu, minimum %zu, chunk alignment %zu): %d\n",
+        __func__, device, physical, reserved, (void *) base, gran_rec, gran_min, align, (int) r_reserve);
+    if (!GGML_CUDA_VMM_OK(r_reserve)) {
+        return nullptr;
+    }
+    GGML_CUDA_VMM_LOG("%s: chunk %zu bytes\n", __func__, chunk);
+    (void) ggml_cuda_vmm_sync(); // its one-time log line not between a mapping and its first access
+    ++ggml_cuda_vmm_stat[0];
+    auto * arena = new ggml_cuda_vmm_arena { buft, device, physical, base, reserved, align, 1 };
+    arena->chunk = chunk;
+    return arena;
+}
+
+// stats[4]: live arenas, mapped bytes, last commit: mapping end -> first access (us), of which the sync (us)
+static void ggml_backend_cuda_vmm_stats(int64_t * stats) {
+    for (int i = 0; i < 4; ++i) {
+        stats[i] = ggml_cuda_vmm_stat[i];
+    }
+}
+
+static size_t ggml_backend_cuda_vmm_arena_alignment(void * arena) {
+    return ((ggml_cuda_vmm_arena *) arena)->align;
+}
+
+// the creator's reference; the address range is freed when the last buffer in it is freed as well
+static void ggml_backend_cuda_vmm_arena_free(void * arena) {
+    ggml_cuda_vmm_arena_unref((ggml_cuda_vmm_arena *) arena);
+}
+
+// a buffer in the arena section [offset, offset + max_size), with size bytes mapped now; offset must be aligned
+static ggml_backend_buffer_t ggml_backend_cuda_vmm_arena_buffer(void * arena_ptr, size_t offset, size_t size, size_t max_size) {
+    auto * arena = (ggml_cuda_vmm_arena *) arena_ptr;
+    const size_t section = arena->align * ((std::max(size, max_size) + arena->align - 1) / arena->align);
+    if (offset % arena->align != 0 || offset + section > arena->reserved) {
+        GGML_CUDA_VMM_LOG("%s: section %zu + %zu does not fit the arena (%zu, alignment %zu)\n", __func__, offset, section, arena->reserved, arena->align);
+        return nullptr;
+    }
+    ggml_cuda_set_device(arena->device);
+    auto * ctx = new ggml_backend_cuda_growable_buffer_context(arena, (CUdeviceptr) ((char *) arena->base + offset), section);
+    if (!ctx->map_to(std::max<size_t>(size, 1))) {
+        GGML_CUDA_VMM_LOG("%s: mapping %zu bytes failed, no growable buffer\n", __func__, size);
+        delete ctx;
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+    GGML_CUDA_VMM_LOG("%s: buffer %p (arena offset %zu): size %zu, mapped %zu, section %zu\n", __func__, (void *) ctx->base, offset, size, ctx->mapped, section);
+    return ggml_backend_buffer_init(arena->buft, ggml_backend_cuda_buffer_interface, ctx, size);
+}
+
+// the arena of a growable buffer, committed after a series of ggml_backend_buffer_grow calls
+static bool ggml_backend_cuda_buffer_grow_commit(ggml_backend_buffer_t buffer) {
+    auto * ctx = dynamic_cast<ggml_backend_cuda_growable_buffer_context *>((ggml_backend_cuda_buffer_context *) buffer->context);
+    return ctx && ggml_cuda_vmm_commit(ctx->arena);
+}
+
+// map more memory at the end of a growable buffer's section (to be committed before any access); false if it is not one, or the memory is not available
+static bool ggml_backend_cuda_buffer_grow(ggml_backend_buffer_t buffer, size_t size) {
+    if (!ggml_backend_buffer_is_cuda(buffer)) {
+        return false;
+    }
+    auto * ctx = dynamic_cast<ggml_backend_cuda_growable_buffer_context *>((ggml_backend_cuda_buffer_context *) buffer->context);
+    if (!ctx) {
+        return false;
+    }
+    if (size <= buffer->size) {
+        return true;
+    }
+    ggml_cuda_set_device(ctx->device);
+    const size_t size_old = buffer->size;
+    if (!ctx->map_to(size)) {
+        GGML_CUDA_VMM_LOG("%s: buffer %p: growing %zu -> %zu failed\n", __func__, (void *) ctx->base, size_old, size);
+        (void) cudaGetLastError();
+        return false;
+    }
+    buffer->size = size;
+    GGML_CUDA_VMM_LOG("%s: buffer %p: %zu -> %zu bytes (mapped %zu of %zu)\n", __func__, (void *) ctx->base, size_old, size, ctx->mapped, ctx->section);
+    return true;
+}
+
+// the chunk size of a growable buffer (every mapping of its arena); 0 if it is not one
+static size_t ggml_backend_cuda_buffer_vmm_chunk(ggml_backend_buffer_t buffer) {
+    if (!ggml_backend_buffer_is_cuda(buffer)) {
+        return 0;
+    }
+    auto * ctx = dynamic_cast<ggml_backend_cuda_growable_buffer_context *>((ggml_backend_cuda_buffer_context *) buffer->context);
+    return ctx ? ctx->arena->chunk : 0;
+}
+
+// true if unmapped chunks keep their memory until the arena's address range is freed: HIP (ROCm 7.2 measurement, ROADMAP.md:
+// unmap + release does not give the VRAM back, it is reused only by mappings in the same range), so a shrink that should give
+// the memory back must free the arena there. GGML_CUDA_VMM_SHRINK=inplace: false (in-place shrink), =free: true
+static bool ggml_backend_cuda_vmm_unmap_keeps_memory(void) {
+    static const int mode = [] {
+        const char * env = getenv("GGML_CUDA_VMM_SHRINK");
+        if (env && strcmp(env, "inplace") == 0) {
+            return 0;
+        }
+        if (env && strcmp(env, "free") == 0) {
+            return 1;
+        }
+#if defined(GGML_USE_HIP)
+        return 1;
+#else
+        return 0;
+#endif
+    }();
+    return mode != 0;
+}
+
+// shrink a growable buffer to size: the whole chunks above it are unmapped (the section keeps its address range, the content
+// below stays); false if it is not one or an unmap fails
+static bool ggml_backend_cuda_buffer_shrink(ggml_backend_buffer_t buffer, size_t size) {
+    if (!ggml_backend_buffer_is_cuda(buffer)) {
+        return false;
+    }
+    auto * ctx = dynamic_cast<ggml_backend_cuda_growable_buffer_context *>((ggml_backend_cuda_buffer_context *) buffer->context);
+    if (!ctx) {
+        return false;
+    }
+    if (size >= buffer->size) {
+        return true;
+    }
+    ggml_cuda_set_device(ctx->device);
+    (void) cudaDeviceSynchronize(); // no stream may use a chunk when it is unmapped
+    const size_t chunk      = ctx->arena->chunk;
+    const size_t keep       = chunk * ((std::max<size_t>(size, 1) + chunk - 1) / chunk);
+    const size_t size_old   = buffer->size;
+    const size_t mapped_old = ctx->mapped;
+    auto & pending = ctx->arena->pending;
+    while (!ctx->mappings.empty() && ctx->mapped - ctx->mappings.back().size >= keep) {
+        const auto m = ctx->mappings.back();
+        const auto r_unmap = cuMemUnmap(m.ptr, m.size);
+        if (!GGML_CUDA_VMM_OK(r_unmap)) {
+            GGML_LOG_ERROR("%s: buffer %p: unmap %p + %zu failed (%d)\n", __func__, (void *) ctx->base, (void *) m.ptr, m.size, (int) r_unmap);
+            (void) cudaGetLastError();
+            return false;
+        }
+        const auto r_release = cuMemRelease(m.handle);
+        if (!GGML_CUDA_VMM_OK(r_release)) {
+            GGML_LOG_ERROR("%s: buffer %p: release of the chunk at %p failed (%d)\n", __func__, (void *) ctx->base, (void *) m.ptr, (int) r_release);
+            (void) cudaGetLastError();
+        }
+        pending.erase(std::remove_if(pending.begin(), pending.end(), [&](const auto & p) { return p.first == m.ptr; }), pending.end());
+        ggml_cuda_vmm_stat[1] -= (int64_t) m.size;
+        ctx->mapped -= m.size;
+        ctx->mappings.pop_back();
+        GGML_CUDA_VMM_LOG("%s: unmap %p + %zu: %d, release: %d\n", __func__, (void *) m.ptr, m.size, (int) r_unmap, (int) r_release);
+    }
+    buffer->size = size;
+    GGML_CUDA_VMM_LOG("%s: buffer %p: %zu -> %zu bytes (mapped %zu -> %zu of %zu)\n", __func__, (void *) ctx->base, size_old, size,
+        mapped_old, ctx->mapped, ctx->section);
+    return true;
+}
+#endif // defined(GGML_USE_VMM) || defined(GGML_USE_HIP)
