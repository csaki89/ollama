+bool llama_context::zones_reserve(uint32_t n_tokens) {
+    auto * kv = zones_kv_init > 0 ? zones_kv() : nullptr;
+    if (!kv || !kv->is_dynamic()) {
+        return true;
+    }
+    // the zone step with the whole remaining prompt: the shrink or growth and the flex moves happen once, here
+    // (the start of a request: the flex layers that are off are tried again with the measured free memory)
+    const uint32_t used = kv->used_cells();
+    const uint32_t size = kv->get_size();
+    zones_reserved = 0;
+    zones_at_start = true;
+    zones_step(n_tokens);
+    zones_at_start = false;
+    zones_reserved      = used + n_tokens;
+    zones_reserved_from = used;
+    const bool ok = kv->get_size() >= std::min(used + n_tokens, kv->dyn_max_size());
+    LLAMA_LOG_INFO("%s: KV reserved for %u + %u tokens: %u -> %u cells%s\n", __func__, used, n_tokens, size, kv->get_size(),
+        ok ? "" : " (not enough, it grows by steps)");
+    return ok;
+}
+
+int64_t llama_context::zones_step_cost(int il, bool exps) const {
+    // the weights of the step, and the K/V of the layer when the whole layer moves (not with its experts only)
+    return (int64_t) (model.flex_layer_bytes(il, exps ? LLAMA_FLEX_EXPS : LLAMA_FLEX_REST) +
+        (!exps && model.flex_whole(il) ? zones_layer_kv_bytes(il) : 0));
+}
+
+bool llama_context::zones_take() {
+    if (parked) {
+        return false; // parked: nothing is on the device, the zone rule waits for the unpark
+    }
+    bool exps = false;
+    const int il = model.flex_next(false, &exps);
+    if (il < 0) {
+        return false;
+    }
+    const int64_t freed = zones_step_cost(il, exps);
+    if (!flex_move_layer(il, false, exps ? LLAMA_FLEX_EXPS : LLAMA_FLEX_REST)) {
+        return false;
+    }
+    zones_headroom += freed;
+    return true;
+}
+
+int llama_context::zones_put_back() {
+    if (parked) {
+        return 0;
+    }
+    int n = 0;
+    bool exps = false;
+    for (int il = model.flex_next(true, &exps); il >= 0; il = model.flex_next(true, &exps)) {
+        const int64_t cost = zones_step_cost(il, exps);
+        if (cost > zones_headroom || !flex_move_layer(il, true, exps ? LLAMA_FLEX_EXPS : LLAMA_FLEX_REST)) {
+            break;
+        }
+        zones_headroom -= cost;
+        n++;
+    }
+    return n;
+}
+
+uint32_t llama_context::zones_shrink_target(uint32_t n_min) const {
+    // the steps that are off, in put-back order: each one needs its weights, a whole layer also its K/V at the new size n;
+    // the shrink frees (size - n) cells of the device K/V. The largest n that lets the most steps back, not below n_min.
+    auto * kv = zones_kv();
+    const uint32_t size = kv->get_size();
+    const int64_t cb = (int64_t) kv->cell_bytes(true);
+    int64_t w = 0, k = 0, s = 0; // weights, K/V bytes per cell of the whole layers, fixed K/V bytes (SWA part)
+    uint32_t res = size;
+    const auto order = model.flex_order();
+    for (auto it = order.rbegin(); it != order.rend(); ++it) {
+        const int  il   = it->first;
+        const bool exps = it->second;
+        if (exps ? !model.flex_exps_off(il) : model.flex_on_gpu(il)) {
+            continue;
+        }
+        w += (int64_t) model.flex_layer_bytes(il, exps ? LLAMA_FLEX_EXPS : LLAMA_FLEX_REST);
+        if (!exps && model.flex_whole(il)) {
+            const size_t own = kv->layer_bytes(il);
+            k += (int64_t) (own / size);
+            s += (int64_t) (zones_layer_kv_bytes(il) - own);
+        }
+        // room at n: headroom + (size - n)*cb >= w + n*k + s
+        const int64_t num = zones_headroom + (int64_t) size*cb - w - s;
+        const int64_t den = cb + k;
+        if (num < 0 || den <= 0) {
+            break;
+        }
+        const int64_t bound = num/den;
+        if (bound >= (int64_t) size) {
+            continue; // this step fits without a shrink
+        }
+        if (bound < (int64_t) n_min) {
+            break;
+        }
+        res = kv->dyn_round_down((uint32_t) bound);
+    }
+    return res;
+}
+
+void llama_context::zones_step(uint32_t n_tokens) {
+    auto * kv = zones_kv_init > 0 ? zones_kv() : nullptr;
+    if (!kv || !kv->is_dynamic()) {
+        return;
+    }
+    // the previous batch must be done before buffers change; not synchronize(), that would account the queued batch in the perf stats
+    auto sync = [&]() {
+        if (sched) {
+            ggml_backend_sched_synchronize(sched.get());
+        }
+    };
+
+    // the flash attention probe has run by now: the dynamic KV needs a non-transposed V cache, not flash attention itself
+    if (!zones_fa_logged) {
+        zones_fa_logged = true;
+        if (cparams.flash_attn) {
+            LLAMA_LOG_INFO("%s: zones: flash attention on, dynamic KV on\n", __func__);
+        } else {
+            LLAMA_LOG_WARN("%s: zones: flash attention is not available on this device (auto resolved it to off): the dynamic KV stays on "
+                "(the V cache was created non-transposed), the attention runs without flash attention\n", __func__);
+        }
+    }
+
+    // zone rule (DESIGN-3zone.md 6.3): device memory budget, booked from the first step on
+    const bool rule = !model.flex_layers().empty();
+    if (rule) {
+        zones_internal_booked(); // the backend's own buffers grew or shrank in the last graphs
+    }
+    if (rule && !zones_headroom_set) {
+        zones_headroom_set = true;
+        size_t dev_free = 0, dev_total = 0;
+        ggml_backend_dev_t zdev = model.flex_gpu_dev(model.flex_layers().front());
+        ggml_backend_dev_memory(zdev, &dev_free, &dev_total);
+        if (!zones_mem_measured(zdev)) {
+            // not measured by the backend: the kernel's figure if there is one, else the booking
+            size_t sys_free = 0;
+            dev_free = zones_sysfs_free(dev_total, sys_free) ? sys_free : zones_booked_free(zdev);
+        }
+        zones_headroom = (int64_t) dev_free - (int64_t) zones_vram_margin;
+        if (const char * env = getenv("LLAMA_ZONES_HEADROOM_MIB")) { // test aid
+            zones_headroom = (int64_t) atoll(env) * 1024 * 1024;
+        }
+        LLAMA_LOG_INFO("%s: zones: device memory budget %.0f MiB (free %.0f MiB, margin %.0f MiB)\n", __func__,
+            zones_headroom / 1048576.0, dev_free / 1048576.0, zones_vram_margin / 1048576.0);
+    } else if (rule && kv->used_cells() == 0 && kv->get_size() == zones_kv_init && zones_kv_size == zones_kv_init) {
+        // at rest (empty KV at the initial size) the budget is measured again: memory taken or freed outside the zones since
+        // the first step counts from here on (the multimodal projector is loaded after the warmup run)
+        zones_clamp(true, true);
+    }
+
+    // a resize outside this step (state load) is booked too; over the budget, flex layers go off first
+    const uint32_t size_in = zones_kv_size != 0 ? zones_kv_size : kv->get_size();
+    int n_off = 0, n_on = 0;
+    if (rule && zones_kv_size != 0 && kv->get_size() != zones_kv_size) {
+        zones_headroom -= ((int64_t) kv->get_size() - (int64_t) zones_kv_size)*(int64_t) kv->cell_bytes(true);
+    }
+    while (rule && zones_headroom < 0 && zones_take()) {
+        n_off++;
+    }
+
+    const uint32_t size = kv->get_size();
+    const uint32_t used = kv->used_cells();
+    bool shrunk = false;
+
+    // a reservation holds while the prompt fills it; it ends when reached, or when cells were removed (a new conversation)
+    if (zones_reserved > 0 && (used >= zones_reserved || used < zones_reserved_from)) {
+        zones_reserved = 0;
+    }
+
+    // shrink when the KV is empty or mostly unused (new conversation, removed sequences), not below a reservation;
+    // with flex layers only as far as the ones that are off can come back (none: no shrink), after the idle time
+    const int64_t t_now = ggml_time_us();
+    if (zones_shrink && size > zones_kv_init && (used == 0 || used < size/4)) {
+        const uint32_t n_min = std::max(zones_kv_init, kv->dyn_round(std::max(used + n_tokens, zones_reserved)));
+        const double idle = zones_t_batch_us > 0 ? (t_now - zones_t_batch_us) / 1e6 : 1e9;
+        uint32_t n = n_min;
+        std::string why;
+        if (zones_shrink_idle_us > 0 && idle*1e6 < zones_shrink_idle_us) {
+            n = size;
+            why = format("idle %.0f s < %.0f s", idle, zones_shrink_idle_us / 1e6);
+        } else if (rule && n_min < size && model.flex_next(true) < 0) {
+            n = size;
+            why = "no flex layer is off";
+        } else if (rule && n_min < size && !zones_at_start && used != 0 && t_now - zones_t_shrink_us < 1000000) {
+            n = size; // between the checks (at most one a second while the KV is mostly unused)
+        } else if (rule && n_min < size) {
+            zones_t_shrink_us = t_now;
+            sync();
+            zones_clamp(true);
+            n = zones_shrink_target(n_min);
+            why = "a shrink lets no more flex steps back";
+        }
+        if (n < size) {
+            sync();
+            const size_t per_cell = kv->cell_bytes(true);
+            if (kv->resize(n)) {
+                zones_headroom += (int64_t) ((size - n)*per_cell);
+                shrunk = true;
+            }
+        } else if (zones_at_start && n_min < size) {
+            LLAMA_LOG_INFO("%s: zones: the KV keeps %u cells (%u needed): %s\n", __func__, size, n_min, why.c_str());
+        }
+    }
+
+    // put the flex steps back, in reverse order, while the budget allows (weights, a whole layer also its K/V at the current size);
+    // the budget is first set to what the device really has free (both ways: the freed memory is back by now)
+    if (rule && (shrunk || used == 0 || zones_at_start) && model.flex_next(true) >= 0) {
+        sync();
+        zones_clamp(true);
+        n_on += zones_put_back();
+    }
+
+    // grow in chunks when the next batch does not fit; take flex steps off (experts first, closest to the CPU first) to make room
+    if (used + n_tokens > kv->get_size() && kv->get_size() < kv->dyn_max_size()) {
+        sync();
+        if (rule) {
+            zones_clamp();
+        }
+        const uint32_t n = kv->dyn_round(used + n_tokens);
+        // the copy path also needs the old and the new K/V of a layer at the same time (resize_peak), the VMM path does not
+        auto need = [&]() { return (int64_t) ((n - kv->get_size())*kv->cell_bytes(true) + kv->resize_peak(n)); };
+        while (rule && need() > zones_headroom && zones_take()) {
+            n_off++;
+        }
+        if (rule && need() > zones_headroom) {
+            LLAMA_LOG_WARN("%s: zones: the KV grows beyond the device memory budget (%.0f MiB over), no flex layer left\n", __func__,
+                (need() - zones_headroom) / 1048576.0);
+        }
+        // the budget books the final growth (the transient peak is gone after the resize)
+        const int64_t growth = (int64_t) ((n - kv->get_size())*kv->cell_bytes(true));
+        if (kv->resize(n)) {
+            zones_headroom -= growth;
+        }
+    }
+    zones_kv_size = kv->get_size();
+
+    // the K/V tensors were reallocated (here or in a state load): new graph and scheduler reservation
+    if (kv->generation() != zones_kv_gen) {
+        zones_kv_gen       = kv->generation();
+        gf_res_prev_active = nullptr;
+        sched_need_reserve = true;
+    }
+
+    if (size_in != zones_kv_size || n_off > 0 || n_on > 0) {
+        char what[96];
+        snprintf(what, sizeof(what), "KV %u -> %u cells, %d flex steps off, %d back", size_in, zones_kv_size, n_off, n_on);
+        zones_log_state(what);
+    }
+}
+
+void llama_context::zones_compute_booked() {
+    // the compute buffer on the device is reserved again for the current KV size: the budget books the change; a smaller
+    // one is memory back, the flex steps that are off are tried again after the reservation
+    ggml_backend_dev_t dev = zones_dev();
+    size_t bytes = 0;
+    for (size_t i = 0; i < backend_ptrs.size() && dev; ++i) {
+        if (ggml_backend_buft_get_device(backend_buft[i]) == dev && !ggml_backend_buft_is_host(backend_buft[i])) {
+            bytes += backend_buf_exp_size[i];
+        }
+    }
+    if (zones_headroom_set && bytes != zones_compute_bytes) {
+        const int64_t delta = (int64_t) bytes - (int64_t) zones_compute_bytes;
+        zones_headroom -= delta;
+        if (std::llabs(delta) >= ((int64_t) 16 << 20)) {
+            LLAMA_LOG_INFO("%s: zones: compute buffer %.0f -> %.0f MiB, budget %.0f MiB\n", __func__,
+                zones_compute_bytes / 1048576.0, bytes / 1048576.0, zones_headroom / 1048576.0);
+        }
+        zones_retry_put_back = delta < 0;
+    }
+    zones_compute_bytes = bytes;
+    zones_internal_booked();
+}
+
+// the free VRAM by the kernel driver (amdgpu sysfs: mem_info_vram_total - mem_info_vram_used) of the card whose total is closest
+// to total (within 1/16); false if there is none (not Linux, not amdgpu)
+static bool zones_sysfs_free(size_t total, size_t & free_out) {
+#if defined(__linux__)
+    size_t best = SIZE_MAX;
+    for (int c = 0; c < 16; ++c) {
+        unsigned long long t = 0, u = 0;
+        const std::string base = "/sys/class/drm/card" + std::to_string(c) + "/device/mem_info_vram_";
+        FILE * ft = fopen((base + "total").c_str(), "r");
+        FILE * fu = ft ? fopen((base + "used").c_str(), "r") : nullptr;
+        const bool ok = ft && fu && fscanf(ft, "%llu", &t) == 1 && fscanf(fu, "%llu", &u) == 1 && u <= t;
+        if (fu) { fclose(fu); }
+        if (ft) { fclose(ft); }
+        const size_t diff = (size_t) (t > total ? t - total : total - t);
+        if (ok && diff <= total/16 && diff < best) {
+            best     = diff;
+            free_out = (size_t) (t - u);
+        }
+    }
+    return best != SIZE_MAX;
+#else
+    GGML_UNUSED(total);
+    GGML_UNUSED(free_out);
+    return false;
+#endif
+}
+
+ggml_backend_dev_t llama_context::zones_dev() const {
+    const auto flex = model.flex_layers();
+    if (!flex.empty()) {
+        return model.flex_gpu_dev(flex.front());
+    }
+    for (const auto & b : backends) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(b.get());
+        if (dev && ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            return dev;
+        }
+    }
+    return nullptr;
+}
+
+size_t llama_context::zones_clamp(bool up, bool rest) {
+    ggml_backend_dev_t dev = zones_dev();
+    if (!dev) {
+        return 0;
+    }
+    size_t dev_free = 0, dev_total = 0;
+    ggml_backend_dev_memory(dev, &dev_free, &dev_total);
+    // the kernel's own figure where there is one: the booked free memory is checked against it, the lower one counts
+    size_t sys_free = 0;
+    const bool sys = zones_sysfs_free(dev_total, sys_free);
+    // a backend that does not measure (the free memory it reports is the total): the driver figure does not count
+    const bool drv = zones_mem_measured(dev);
+    if (!drv && !sys) {
+        // nothing measures the device: the budget follows the booking only
+        return zones_booked_free(dev);
+    }
+    const int64_t booked = zones_headroom + (int64_t) zones_vram_margin;
+    if (!rest && sys && std::llabs(booked - (int64_t) sys_free) > (int64_t) zones_vram_margin/2) {
+        LLAMA_LOG_WARN("%s: zones: the booked free memory (%.0f MiB) is off from the device: driver %.0f MiB, sysfs %.0f MiB\n", __func__,
+            booked / 1048576.0, dev_free / 1048576.0, sys_free / 1048576.0);
+    }
+    const size_t free_real = sys ? (drv ? std::min(dev_free, sys_free) : sys_free) : dev_free;
+    const int64_t real = (int64_t) free_real - (int64_t) zones_vram_margin;
+    if ((real < zones_headroom || (up && real > zones_headroom)) && !getenv("LLAMA_ZONES_HEADROOM_MIB")) {
+        // at rest only a change of 64 MiB or more is logged
+        if (!rest || std::llabs(real - zones_headroom) >= ((int64_t) 64 << 20)) {
+            LLAMA_LOG_INFO("%s: zones: budget %.0f -> %.0f MiB (measured free %.0f MiB: driver %.0f, sysfs %s; margin %.0f MiB%s)\n", __func__,
+                zones_headroom / 1048576.0, real / 1048576.0, free_real / 1048576.0, dev_free / 1048576.0,
+                sys ? std::to_string(sys_free >> 20).c_str() : "-", zones_vram_margin / 1048576.0, rest ? ", at rest" : "");
+        }
+        zones_headroom = real;
+    }
+    return free_real;
+}
+
+llama_kv_cache * llama_context::zones_kv() const {
+    return zones_parts(memory.get()).kv;
+}
+
+bool llama_context::zones_mem_measured(ggml_backend_dev_t dev) {
+    if (zones_measured >= 0) {
+        return zones_measured != 0;
+    }
+    // a backend tells whether ggml_backend_dev_memory measures (Vulkan without VK_EXT_memory_budget reports the heap size);
+    // without the query it is a measurement (CUDA/HIP)
+    bool measured = true;
+    ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    auto fn = reg ? (bool (*)(ggml_backend_dev_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_dev_memory_measured") : nullptr;
+    if (fn) {
+        measured = fn(dev);
+    }
+    zones_measured = measured ? 1 : 0;
+    if (!measured) {
+        size_t sys_free = 0, dev_free = 0, dev_total = 0;
+        ggml_backend_dev_memory(dev, &dev_free, &dev_total);
+        const bool sys = zones_sysfs_free(dev_total, sys_free);
+        LLAMA_LOG_WARN("%s: zones: %s does not measure its free memory (no memory budget): the budget follows %s\n", __func__,
+            ggml_backend_dev_name(dev), sys ? "the kernel's sysfs figure" : "the booking only (the device total minus the model weights, the K/V and the compute buffers on it)");
+    }
+    return measured;
+}
+
+size_t llama_context::zones_booked_free(ggml_backend_dev_t dev) const {
+    size_t dev_free = 0, dev_total = 0;
+    ggml_backend_dev_memory(dev, &dev_free, &dev_total);
+    size_t used = 0;
+    for (const auto & [buft, size] : model.memory_breakdown()) {
+        if (ggml_backend_buft_get_device(buft) == dev && !ggml_backend_buft_is_host(buft)) {
+            used += size;
+        }
+    }
+    const auto parts = zones_parts(memory.get());
+    std::vector<const llama_kv_cache *> kvs;
+    if (parts.kv) {
+        kvs.push_back(parts.kv);
+    }
+    for (const auto & [name, part] : parts.fixed) {
+        if (const auto * kv = dynamic_cast<const llama_kv_cache *>(part)) {
+            kvs.push_back(kv);
+        }
+    }
+    for (const auto * kv : kvs) {
+        used += (size_t) kv->get_size() * kv->cell_bytes(true);
+    }
+    if (sched) {
+        for (const auto & b : backends) {
+            if (ggml_backend_get_device(b.get()) == dev) {
+                used += ggml_backend_sched_get_buffer_size(sched.get(), b.get());
+            }
+        }
+    }
+    used += zones_internal_query(dev);
+    return dev_total > used ? dev_total - used : 0;
+}
+
+// device memory the backend holds outside the ggml buffers' sizes (ggml_backend_dev_internal_memory: Vulkan's own graph
+// buffers and the sparse chunk rounding); 0 without the query (CUDA/HIP)
+size_t llama_context::zones_internal_query(ggml_backend_dev_t dev) {
+    ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    auto fn = reg ? (size_t (*)(ggml_backend_dev_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_dev_internal_memory") : nullptr;
+    return fn ? fn(dev) : 0;
+}
+
+// the change of that memory is booked like the compute buffer (a smaller one is memory back: the flex steps are tried again)
+void llama_context::zones_internal_booked() {
+    const size_t bytes = zones_internal_query(zones_dev());
+    if (zones_headroom_set && bytes != zones_internal_bytes) {
+        const int64_t delta = (int64_t) bytes - (int64_t) zones_internal_bytes;
+        zones_headroom -= delta;
+        if (std::llabs(delta) >= ((int64_t) 16 << 20)) {
+            LLAMA_LOG_INFO("%s: zones: backend buffers outside the ggml buffers %.0f -> %.0f MiB, budget %.0f MiB\n", __func__,
+                zones_internal_bytes / 1048576.0, bytes / 1048576.0, zones_headroom / 1048576.0);
+        }
+        if (delta < 0) {
+            zones_retry_put_back = true;
+        }
+    }
+    zones_internal_bytes = bytes;
+}
+
+size_t llama_context::zones_layer_kv_bytes(int il) const {
+    const auto parts = zones_parts(memory.get());
+    size_t res = parts.kv ? parts.kv->layer_bytes(il) : 0;
+    for (const auto & [name, part] : parts.fixed) {
+        if (const auto * kv = dynamic_cast<const llama_kv_cache *>(part)) {
+            res += kv->layer_bytes(il);
+        }
+    }
+    return res;
+}
+
+void llama_context::zones_static(size_t extra) {
+    // the flex band was sized from the K/V of the initial size; the static K/V needs extra more device memory: the same
+    // order as the zone rule (experts first, closest to the CPU first), until it is freed (no budget yet, it is not booked)
+    const int64_t h0 = zones_headroom;
+    size_t freed = 0;
+    int n_off = 0;
+    while (freed < extra && zones_take()) {
+        freed = (size_t) (zones_headroom - h0);
+        n_off++;
+    }
+    zones_headroom = h0;
+    if (extra > 0 && !model.flex_layers().empty()) {
+        LLAMA_LOG_INFO("%s: zones: static KV, %.0f MiB more on the device than at the initial size: %d flex steps off (%.0f MiB)%s\n", __func__,
+            extra / 1048576.0, n_off, freed / 1048576.0, freed < extra ? ", no flex layer left" : "");
+        zones_log_state("static KV");
+    }
+}
+
+void llama_context::zones_log_state(const char * what) {
+    const auto parts = zones_parts(memory.get());
+    auto * kv = parts.kv;
+    // the parts that keep their size, on the device
+    std::string fixed;
+    for (const auto & [name, part] : parts.fixed) {
+        char buf[96];
+        snprintf(buf, sizeof(buf), "%s%s %.0f MiB", fixed.empty() ? "; fixed on the device: " : ", ", name, zones_dev_bytes(part) / 1048576.0);
+        fixed += buf;
+    }
+    size_t w_gpu = 0;
+    for (const auto & [buft, size] : model.memory_breakdown()) {
+        ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+        if (dev && ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU && !ggml_backend_buft_is_host(buft)) {
+            w_gpu += size;
+        }
+    }
+    const size_t w_all = std::max(model.size(), w_gpu);
+
+    // the flex layers that are off, and the whole layers with only their experts off, as ranges
+    const auto flex = model.flex_layers();
+    auto ranges = [&](auto pred) {
+        std::string res;
+        for (size_t i = 0; i < flex.size(); ++i) {
+            if (!pred(flex[i])) {
+                continue;
+            }
+            size_t j = i;
+            while (j + 1 < flex.size() && pred(flex[j + 1]) && flex[j + 1] == flex[j] + 1) {
+                j++;
+            }
+            res += (res.empty() ? "" : ",") + std::to_string(flex[i]) + (j > i ? "-" + std::to_string(flex[j]) : "");
+            i = j;
+        }
+        return res;
+    };
+    const std::string off  = ranges([&](int il) { return !model.flex_on_gpu(il); });
+    const std::string exps = ranges([&](int il) { return model.flex_on_gpu(il) && model.flex_exps_off(il); });
+    int n_flex_on = 0;
+    for (int il : flex) {
+        n_flex_on += model.flex_on_gpu(il) && !model.flex_exps_off(il);
+    }
+
+    size_t dev_free = 0, dev_total = 0;
+    bool drv = true;
+    if (ggml_backend_dev_t dev = zones_dev()) {
+        ggml_backend_dev_memory(dev, &dev_free, &dev_total);
+        drv = zones_mem_measured(dev);
+    }
+    size_t sys_free = 0;
+    const bool sys = zones_sysfs_free(dev_total, sys_free);
+    // no budget yet (static KV): booked and budget are not known; a driver that does not measure: "-"
+    const std::string booked = zones_headroom_set ? std::to_string((zones_headroom + (int64_t) zones_vram_margin) >> 20) : "-";
+    const std::string budget = zones_headroom_set ? std::to_string(zones_headroom / 1048576) : "-";
+    const std::string drv_free = drv ? format("%.0f", dev_free / 1048576.0) : "-";
+    LLAMA_LOG_INFO("%s: zones_state (%s): weights GPU %.0f MiB (%.0f%%), CPU %.0f MiB; flex %d/%zu layers on the GPU%s%s%s%s; "
+        "KV %u cells (%u used, %.0f MiB on the device)%s; device free: booked %s, driver %s, sysfs %s MiB (budget %s MiB, margin %.0f MiB)\n",
+        __func__, what,
+        w_gpu / 1048576.0, w_all > 0 ? 100.0*w_gpu/w_all : 0.0, (w_all - w_gpu) / 1048576.0, n_flex_on, flex.size(),
+        off.empty() ? "" : ", off: ", off.c_str(), exps.empty() ? "" : ", experts off: ", exps.c_str(), kv ? kv->get_size() : 0, kv ? kv->used_cells() : 0,
+        kv ? kv->get_size()*kv->cell_bytes(true) / 1048576.0 : 0.0, fixed.c_str(), booked.c_str(),
+        drv_free.c_str(), sys ? std::to_string(sys_free >> 20).c_str() : "-", budget.c_str(),
+        zones_vram_margin / 1048576.0);
+}
+
+bool llama_context::flex_move_layer(int il, bool to_gpu, int part) {
+    // the previous batch must be done; not synchronize(), that would account the queued batch in the perf stats
+    if (sched) {
+        ggml_backend_sched_synchronize(sched.get());
+    }
+    // the GPU backend of the layer, for asynchronous (DMA) copies
+    ggml_backend_t backend_gpu = nullptr;
+    if (!flex_test_copy_legacy) {
+        for (auto & b : backends) {
+            if (ggml_backend_get_device(b.get()) == model.flex_gpu_dev(il)) {
+                backend_gpu = b.get();
+            }
+        }
+    }
+    if (!model.flex_move(il, to_gpu, flex_test_file, part)) {
+        return false;
+    }
+    if (sched) {
+        flex_set_alts(il);
+    }
+    // the layer's K/V follows the weights (LLAMA_FLEX_TEST_KV=0 keeps it in place, for comparison)
+    // (the SWA K/V too; a recurrent state stays where it is, it is small and does not grow; not with the experts only)
+    if (flex_test_kv && model.flex_whole(il) && part != LLAMA_FLEX_EXPS) {
+        const auto parts = zones_parts(memory.get());
+        if (parts.kv) {
+            parts.kv->flex_move(il, to_gpu, backend_gpu, flex_test_copy_legacy);
+            for (const auto & [name, part] : parts.fixed) {
+                if (auto * kv = dynamic_cast<llama_kv_cache *>(part)) {
+                    kv->flex_move(il, to_gpu, backend_gpu, flex_test_copy_legacy);
+                }
+            }
+        } else {
+            LLAMA_LOG_WARN("%s: flex: this memory type does not support moving the K/V, it stays in place\n", __func__);
+        }
+    }
+    // the weight placement changed: build the next graph again
+    gf_res_prev_active = nullptr;
+    return true;
+}
+
+void llama_context::flex_set_alts(int il) {
+    // a flex layer (or its experts) that is off uses its host copies for op offload, like a dual-buffer CPU layer
+    for (const auto & [w, host] : model.flex_host_alts(il)) {
+        ggml_backend_sched_set_weight_alt(sched.get(), w, flex_use_host ? host : nullptr);
+    }
+}
