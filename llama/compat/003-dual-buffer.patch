+bool llama_kv_cache::flex_move(int32_t il, bool to_gpu, ggml_backend_t backend, bool legacy) {
+    auto it = flex_kv_layers.find(il);
+    if (it == flex_kv_layers.end()) {
+        return false;
+    }
+    auto & fk = it->second;
+    if (fk.on_gpu == to_gpu) {
+        return true;
+    }
+
+    const int64_t t0 = ggml_time_us();
+
+    // CPU side: the device host buffer (pinned memory, the backend copies it with DMA), else the CPU buffer
+    // legacy (test): the CPU buffer, a full synchronous copy
+    ggml_backend_buffer_type_t buft = fk.buft_gpu;
+    if (!to_gpu) {
+        buft = legacy ? nullptr : ggml_backend_dev_host_buffer_type(ggml_backend_buft_get_device(fk.buft_gpu));
+        if (!buft) {
+            auto * cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+            if (!cpu_dev) {
+                return false;
+            }
+            buft = ggml_backend_dev_buffer_type(cpu_dev);
+        }
+    }
+    if (legacy) {
+        backend = nullptr;
+    }
+
+    auto & layer = layers[map_layer_ids.at(il)];
+    std::vector<ggml_tensor *> tensors;
+    for (ggml_tensor * t : { layer.k, layer.v }) {
+        if (t) {
+            tensors.push_back(t);
+        }
+    }
+
+    const size_t align = ggml_backend_buft_get_alignment(buft);
+    size_t size = 0;
+    for (ggml_tensor * t : tensors) {
+        size += GGML_PAD(ggml_backend_buft_get_alloc_size(buft, t), align);
+    }
+    // reuse the host buffer kept from the last time the layer was off (the allocation of pinned memory is the slow part)
+    ggml_backend_buffer_t buf = nullptr;
+    const bool reused = !to_gpu && fk.spare && ggml_backend_buffer_get_type(fk.spare.get()) == buft && ggml_backend_buffer_get_size(fk.spare.get()) >= size;
+    if (reused) {
+        buf = fk.spare.release();
+    } else {
+        fk.spare.reset();
+        buf = ggml_backend_buft_alloc_buffer(buft, size);
+    }
+    if (!buf) {
+        LLAMA_LOG_ERROR("%s: layer %d: failed to allocate %zu bytes in %s\n", __func__, il, size, ggml_backend_buft_name(buft));
+        return false;
+    }
+    const int64_t t1 = ggml_time_us();
+    ggml_backend_buffer_clear(buf, 0);
+    const int64_t t2 = ggml_time_us();
+
+    // only the used cells hold data: rows [0, n_used) of each stream (all of V if it is transposed)
+    uint32_t n_used = 0;
+    for (const auto & cells : v_cells) {
+        n_used = std::max(n_used, cells.used_max_p1());
+    }
+    if (legacy) {
+        n_used = get_size();
+    }
+
+    // allocate the K/V in the new buffer and copy the content from the old one
+    ggml_tallocr talloc = ggml_tallocr_new(buf);
+    size_t n_copied = 0;
+    std::vector<uint8_t> tmp;
+    for (ggml_tensor * t : tensors) {
+        ggml_tensor old = *t;
+        t->buffer = nullptr;
+        t->data   = nullptr;
+        ggml_tallocr_alloc(&talloc, t);
+
+        const bool rows = !(t == layer.v && v_trans);
+        const size_t n_rows = rows ? n_used : t->ne[1];
+        for (int64_t s = 0; s < t->ne[2] && n_rows > 0; ++s) {
+            const size_t off = s*t->nb[2];
+            const size_t len = n_rows*t->nb[1];
+            const bool src_host = ggml_backend_buffer_is_host(old.buffer);
+            const bool dst_host = ggml_backend_buffer_is_host(t->buffer);
+            // to the GPU: a synchronous set (the backend picks DMA from pinned memory or a direct write on UMA)
+            // from the GPU: asynchronous into pinned memory, a synchronous read can be a slow CPU read of device memory (DECISIONS.md 19)
+            if (src_host) {
+                ggml_backend_tensor_set(t, (const char *) old.data + off, off, len);
+            } else if (dst_host) {
+                if (backend) {
+                    ggml_backend_tensor_get_async(backend, &old, (char *) t->data + off, off, len);
+                } else {
+                    ggml_backend_tensor_get(&old, (char *) t->data + off, off, len);
+                }
+            } else {
+                tmp.resize(len);
+                ggml_backend_tensor_get(&old, tmp.data(), off, len);
+                ggml_backend_tensor_set(t, tmp.data(), off, len);
+            }
+            n_copied += len;
+        }
+    }
+    if (backend) {
+        ggml_backend_synchronize(backend);
+    }
+    const int64_t t3 = ggml_time_us();
+
+    // the per-stream views point into the K/V
+    for (auto * views : { &layer.k_stream, &layer.v_stream }) {
+        for (ggml_tensor * v : *views) {
+            if (v && v->view_src) {
+                v->buffer = v->view_src->buffer;
+                v->data   = (char *) v->view_src->data + v->view_offs;
+            }
+        }
+    }
+
+    // frees the old buffer; a host buffer is kept for the next time the layer goes off (not in legacy mode)
+    ggml_backend_buffer_ptr old(ctxs_bufs[fk.buf_idx].second.release());
+    ctxs_bufs[fk.buf_idx].second.reset(buf);
+    if (to_gpu && !legacy && old && ggml_backend_buffer_is_host(old.get())) {
+        fk.spare = std::move(old);
+    }
+    old.reset();
+    fk.on_gpu = to_gpu;
+    const int64_t t4 = ggml_time_us();
+
+    LLAMA_LOG_INFO("%s: layer %d K/V moved to %s (%.2f MiB, %u cells, %.2f MiB copied, %.1f ms: alloc %.1f%s, clear %.1f, copy+sync %.1f, free %.1f%s)\n",
+        __func__, il, ggml_backend_buft_name(buft), size / 1024.0 / 1024.0, n_used, n_copied / 1024.0 / 1024.0, (t4 - t0) / 1000.0,
+        (t1 - t0) / 1000.0, reused ? " (reused)" : "", (t2 - t1) / 1000.0, (t3 - t2) / 1000.0, (t4 - t3) / 1000.0, legacy ? ", legacy" : "");
+    return true;
+}
+
+static size_t kv_vmm_chunk(ggml_backend_buffer_t buffer); // the VMM chunk of a growable K/V buffer, 0 otherwise (below)
+
+bool llama_kv_cache::set_dynamic(uint32_t max_size, size_t chunk_bytes) {
+    // every layer must own its K/V (no sharing or reuse), V not transposed (its rows depend on the size), real buffers
+    if (v_trans) {
+        LLAMA_LOG_WARN("%s: dynamic KV disabled: the V cache is transposed because flash attention is off (-fa off, OLLAMA_FLASH_ATTENTION=0)\n", __func__);
+        return false;
+    }
+    if (other || hparams.no_alloc || swa_type != LLAMA_SWA_TYPE_NONE || map_layer_ids.size() != layers.size() || max_size <= get_size()) {
+        return false;
+    }
+    const size_t per_cell = cell_bytes(false);
+    if (per_cell == 0) {
+        return false;
+    }
+    dyn_max   = max_size;
+    dyn_chunk = GGML_PAD(std::max<size_t>(1, chunk_bytes / per_cell), 256);
+    dyn_base  = get_size();
+    const char * env = getenv("LLAMA_KV_NO_VMM");
+    dyn_vmm_off = env && atoi(env) != 0;
+    dyn_vmm.assign(layers.size(), 0);
+
+    // one buffer per layer from now on; on a device with virtual memory the K and V get growable buffers
+    if (!relayout(get_size(), true)) {
+        dyn_max = 0;
+        return false;
+    }
+    size_t n_vmm = 0, n_dev = 0;
+    for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+        n_vmm += dyn_vmm[ikv];
+        n_dev += layers[ikv].k->buffer && !ggml_backend_buffer_is_host(layers[ikv].k->buffer);
+    }
+    // VMM: one step maps one chunk of every section: the cells of a chunk of the largest section row (K or V of a layer),
+    // a multiple of 256 cells (the KV size stays padded); the copy path keeps the steps of chunk_bytes
+    size_t vmm_chunk = 0, vmm_row = 0;
+    for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+        for (const ggml_tensor * t : { layers[ikv].k, layers[ikv].v }) {
+            if (dyn_vmm[ikv] && t) {
+                const size_t c = kv_vmm_chunk(t->buffer);
+                vmm_chunk = vmm_chunk == 0 ? c : std::min(vmm_chunk, c);
+                vmm_row   = std::max(vmm_row, (size_t) (t->nb[1]*t->ne[2]));
+            }
+        }
+    }
+    if (vmm_chunk > 0 && vmm_row > 0) {
+        const uint32_t cells = (uint32_t) std::min<size_t>(vmm_chunk / vmm_row, dyn_max);
+        dyn_chunk = std::max<uint32_t>(256, cells - cells % 256);
+    }
+    LLAMA_LOG_INFO("%s: dynamic KV: %u -> %u cells, chunk %u cells (%.2f MiB%s); growth on the device: %zu/%zu layers in place (VMM), %zu by copy%s\n",
+        __func__, get_size(), dyn_max, dyn_chunk, dyn_chunk * per_cell / 1024.0 / 1024.0,
+        vmm_chunk > 0 ? ", one VMM chunk per section" : "", n_vmm, n_dev, n_dev - n_vmm,
+        dyn_vmm_off ? " (LLAMA_KV_NO_VMM)" : (n_vmm < n_dev ? " (no VMM on this backend/device, or flex layers)" : ""));
+    return true;
+}
+
+// growable device buffers (ggml-cuda/HIP VMM), looked up through the backend registry; NULL if the backend has none:
+// one arena (a reserved address range) per device and relayout, a section in it for every K and V, grown in place
+typedef void *                (*ggml_backend_vmm_arena_new_t)(ggml_backend_buffer_type_t buft, size_t size);
+typedef size_t                (*ggml_backend_vmm_arena_alignment_t)(void * arena);
+typedef ggml_backend_buffer_t (*ggml_backend_vmm_arena_buffer_t)(void * arena, size_t offset, size_t size, size_t max_size);
+typedef void                  (*ggml_backend_vmm_arena_free_t)(void * arena);
+typedef bool                  (*ggml_backend_buffer_grow_t)(ggml_backend_buffer_t buffer, size_t size);
+// unmaps the whole chunks above size (the content below stays)
+typedef bool                  (*ggml_backend_buffer_shrink_t)(ggml_backend_buffer_t buffer, size_t size);
+// the size of every mapping of a growable buffer (0 if it is not one)
+typedef size_t                (*ggml_backend_buffer_vmm_chunk_t)(ggml_backend_buffer_t buffer);
+// new mappings must not be accessed before a commit: it waits until they are valid and zeroes them
+typedef bool                  (*ggml_backend_vmm_arena_commit_t)(void * arena);
+typedef bool                  (*ggml_backend_buffer_grow_commit_t)(ggml_backend_buffer_t buffer);
+// true if unmapped chunks keep their memory until the arena is freed (HIP): a shrink then frees the arena instead
+typedef bool                  (*ggml_backend_vmm_unmap_keeps_memory_t)(void);
+
+// test aid (LLAMA_KV_VMM_SIM=1): growable buffers simulated with a buffer of the section size, to test the in-place path without VMM;
+// LLAMA_KV_VMM_SIM=2: every commit fails, 3: only the growth commits fail (the fallbacks to a copy, as when the HIP barrier allocation fails),
+// 4: the unmapped memory is kept (HIP), a shrink frees the arenas and goes through the host
+static int kv_sim_level() {
+    static const int level = getenv("LLAMA_KV_VMM_SIM") ? atoi(getenv("LLAMA_KV_VMM_SIM")) : 0;
+    return level;
+}
+struct kv_sim_arena {
+    ggml_backend_buffer_type_t buft;
+};
+static void * kv_sim_arena_new(ggml_backend_buffer_type_t buft, size_t size) {
+    GGML_UNUSED(size);
+    return new kv_sim_arena { buft };
+}
+static size_t kv_sim_arena_alignment(void * arena) {
+    GGML_UNUSED(arena);
+    return 2u << 20;
+}
+static ggml_backend_buffer_t kv_sim_arena_buffer(void * arena, size_t offset, size_t size, size_t max_size) {
+    GGML_UNUSED(offset);
+    return ggml_backend_buft_alloc_buffer(((kv_sim_arena *) arena)->buft, std::max(size, max_size));
+}
+static void kv_sim_arena_free(void * arena) {
+    delete (kv_sim_arena *) arena;
+}
+static bool kv_sim_grow(ggml_backend_buffer_t buffer, size_t size) {
+    return size <= ggml_backend_buffer_get_size(buffer);
+}
+static bool kv_sim_shrink(ggml_backend_buffer_t buffer, size_t size) {
+    GGML_UNUSED(buffer);
+    GGML_UNUSED(size);
+    return true;
+}
+static size_t kv_sim_vmm_chunk(ggml_backend_buffer_t buffer) {
+    GGML_UNUSED(buffer);
+    return 1u << 20;
+}
+
+static bool kv_sim_arena_commit(void * arena) {
+    GGML_UNUSED(arena);
+    return kv_sim_level() != 2;
+}
+static bool kv_sim_grow_commit(ggml_backend_buffer_t buffer) {
+    GGML_UNUSED(buffer);
+    return kv_sim_level() != 2 && kv_sim_level() != 3;
+}
+static bool kv_sim_unmap_keeps_memory(void) {
+    return kv_sim_level() == 4;
+}
+
+static void * kv_growable_fn(ggml_backend_buffer_type_t buft, const char * name) {
+    ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+    if (!dev || ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+        return nullptr;
+    }
+    if (kv_sim_level() != 0) {
+        if (strcmp(name, "ggml_backend_vmm_arena_new")       == 0) { return (void *) kv_sim_arena_new; }
+        if (strcmp(name, "ggml_backend_vmm_arena_alignment") == 0) { return (void *) kv_sim_arena_alignment; }
+        if (strcmp(name, "ggml_backend_vmm_arena_buffer")    == 0) { return (void *) kv_sim_arena_buffer; }
+        if (strcmp(name, "ggml_backend_vmm_arena_free")      == 0) { return (void *) kv_sim_arena_free; }
+        if (strcmp(name, "ggml_backend_buffer_grow")         == 0) { return (void *) kv_sim_grow; }
+        if (strcmp(name, "ggml_backend_buffer_shrink")       == 0) { return (void *) kv_sim_shrink; }
+        if (strcmp(name, "ggml_backend_buffer_vmm_chunk")    == 0) { return (void *) kv_sim_vmm_chunk; }
+        if (strcmp(name, "ggml_backend_vmm_arena_commit")    == 0) { return (void *) kv_sim_arena_commit; }
+        if (strcmp(name, "ggml_backend_buffer_grow_commit")  == 0) { return (void *) kv_sim_grow_commit; }
+        if (strcmp(name, "ggml_backend_vmm_unmap_keeps_memory") == 0) { return (void *) kv_sim_unmap_keeps_memory; }
+        return nullptr;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    return reg ? ggml_backend_reg_get_proc_address(reg, name) : nullptr;
+}
+
+static size_t kv_vmm_chunk(ggml_backend_buffer_t buffer) {
+    auto fn = (ggml_backend_buffer_vmm_chunk_t) kv_growable_fn(ggml_backend_buffer_get_type(buffer), "ggml_backend_buffer_vmm_chunk");
+    return fn ? fn(buffer) : 0;
+}
+
+size_t llama_kv_cache::resize_peak(uint32_t n) const {
+    // the copy path allocates a layer's new K/V before it frees the old one: the largest old device layer is the transient extra
+    size_t res = 0;
+    if (n <= get_size()) {
+        return 0;
+    }
+    for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+        const auto & layer = layers[ikv];
+        const bool dev = layer.k->buffer && !ggml_backend_buffer_is_host(layer.k->buffer);
+        if (dev && (dyn_vmm.size() <= ikv || !dyn_vmm[ikv])) {
+            res = std::max(res, ggml_nbytes(layer.k) + (layer.v ? ggml_nbytes(layer.v) : 0));
+        }
+    }
+    return res;
+}
+
+uint32_t llama_kv_cache::dyn_round(uint32_t n) const {
+    if (dyn_chunk == 0) {
+        return n;
+    }
+    // steps of dyn_chunk from the starting size (rounding to multiples of the chunk made 4096 -> 4608 with a 768 cell chunk)
+    if (n <= dyn_base) {
+        return dyn_base;
+    }
+    return std::min<uint32_t>(dyn_max, dyn_base + ((n - dyn_base + dyn_chunk - 1)/dyn_chunk)*dyn_chunk);
+}
+
+uint32_t llama_kv_cache::used_cells() const {
+    uint32_t n = 0;
+    for (const auto & cells : v_cells) {
+        n = std::max(n, cells.used_max_p1());
+    }
+    return n;
+}
+
+size_t llama_kv_cache::cell_bytes(bool device_only) const {
+    size_t res = 0;
+    for (const auto & layer : layers) {
+        for (const ggml_tensor * t : { layer.k, layer.v }) {
+            if (t && (!device_only || (t->buffer && !ggml_backend_buffer_is_host(t->buffer)))) {
+                res += t->nb[1]*t->ne[2];
+            }
+        }
+    }
+    return res;
+}
+
+size_t llama_kv_cache::layer_bytes(int32_t il) const {
+    auto it = map_layer_ids.find(il);
+    if (it == map_layer_ids.end()) {
+        return 0;
+    }
+    const auto & layer = layers[it->second];
+    return (layer.k ? ggml_nbytes(layer.k) : 0) + (layer.v ? ggml_nbytes(layer.v) : 0);
+}
+
+bool llama_kv_cache::resize(uint32_t n) {
+    return relayout(n, false);
+}
+
+bool llama_kv_cache::relayout(uint32_t n, bool force) {
+    const uint32_t n_old  = get_size();
+    const uint32_t n_used = used_cells();
+    if (n == n_old && !force) {
+        return true;
+    }
+    if (n < n_used || layers.empty()) {
+        return false;
+    }
+
+    const int64_t t0 = ggml_time_us();
+    int64_t t_alloc = 0, t_copy = 0, t_free = 0;
+    size_t n_grow = 0, n_vmm_new = 0, n_copy = 0;
+
+    // the buffers of each layer (K and V are separate in a growable layout); a buffer shared by several layers is freed at the end
+    std::vector<size_t> owner(ctxs_bufs.size(), SIZE_MAX);
+    std::vector<size_t> n_owners(ctxs_bufs.size(), 0);
+    for (size_t ib = 0; ib < ctxs_bufs.size(); ++ib) {
+        for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+            const auto * b = ctxs_bufs[ib].second.get();
+            if (b && (layers[ikv].k->buffer == b || (layers[ikv].v && layers[ikv].v->buffer == b))) {
+                owner[ib] = ikv;
+                n_owners[ib]++;
+            }
+        }
+    }
+    if (dyn_vmm.size() != layers.size()) {
+        dyn_vmm.assign(layers.size(), 0);
+    }
+    // the buffer type of each layer, read before a shrink frees buffers early
+    std::vector<ggml_backend_buffer_type_t> buft_of(layers.size());
+    std::vector<uint8_t> on_host(layers.size());
+    for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+        buft_of[ikv] = ggml_backend_buffer_get_type(layers[ikv].k->buffer);
+        on_host[ikv] = ggml_backend_buffer_is_host(layers[ikv].k->buffer);
+    }
+
+    // growable K/V: map more memory at the end first, for all the layers, then one commit (the mappings are not valid before it)
+    std::vector<uint8_t> grown(layers.size(), 0);
+    if (n > n_old && !force) {
+        const int64_t t1 = ggml_time_us();
+        std::map<ggml_backend_buffer_type_t, ggml_backend_buffer_t> buf_grown; // one grown buffer per device (arena)
+        for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+            if (!dyn_vmm[ikv]) {
+                continue;
+            }
+            auto & layer = layers[ikv];
+            ggml_backend_buffer_type_t buft = buft_of[ikv];
+            auto grow = (ggml_backend_buffer_grow_t) kv_growable_fn(buft, "ggml_backend_buffer_grow");
+            bool ok = grow != nullptr;
+            for (ggml_tensor * t : { layer.k, layer.v }) {
+                if (ok && t) {
+                    ok = grow(t->buffer, t->nb[1]*n*t->ne[2]);
+                }
+            }
+            if (ok) {
+                grown[ikv] = 1;
+                buf_grown[buft] = layer.k->buffer;
+            } else {
+                LLAMA_LOG_WARN("%s: layer %u: growing the K/V in place failed (VMM), falling back to a new buffer and a copy\n", __func__, layer.il);
+                dyn_vmm[ikv] = 0;
+            }
+        }
+        // a failed commit: the new mappings of that device are never accessed, its layers grow by copy (the old buffers go at the end)
+        for (const auto & [buft, buf] : buf_grown) {
+            auto commit = (ggml_backend_buffer_grow_commit_t) kv_growable_fn(buft, "ggml_backend_buffer_grow_commit");
+            if (commit && commit(buf)) {
+                continue;
+            }
+            LLAMA_LOG_ERROR("%s: the new K/V mappings on %s could not be committed, falling back to new buffers and a copy\n", __func__, ggml_backend_buft_name(buft));
+            for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+                if (grown[ikv] && buft_of[ikv] == buft) {
+                    grown[ikv]   = 0;
+                    dyn_vmm[ikv] = 0;
+                }
+            }
+        }
+        t_alloc += ggml_time_us() - t1;
+    }
+
+    // growable K/V shrinking: the used cells are below n, only the whole free chunks at the top are unmapped (no allocation, no copy);
+    // where unmapped chunks keep their memory (HIP), the used rows go to the host and the arena is freed (its VRAM comes back),
+    // the layer gets a new section below
+    std::vector<std::vector<uint8_t>> staged(2*layers.size());
+    std::vector<uint8_t> via_host(layers.size(), 0);
+    size_t n_via_host = 0;
+    size_t n_lost_vmm = 0, n_on_cpu = 0; // of those: no new section, an ordinary device buffer / the CPU instead
+    if (n < n_old && !force) {
+        const int64_t t1 = ggml_time_us();
+        for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+            if (!dyn_vmm[ikv]) {
+                continue;
+            }
+            auto & layer = layers[ikv];
+            auto keeps = (ggml_backend_vmm_unmap_keeps_memory_t) kv_growable_fn(buft_of[ikv], "ggml_backend_vmm_unmap_keeps_memory");
+            if (keeps && keeps()) {
+                int i = 0;
+                for (ggml_tensor * t : { layer.k, layer.v }) {
+                    auto & h = staged[2*ikv + i++];
+                    if (t && n_used > 0) {
+                        h.resize(t->nb[1]*n_used*t->ne[2]);
+                        ggml_backend_tensor_get(t, h.data(), 0, h.size());
+                    }
+                }
+                via_host[ikv] = 1;
+                n_via_host++;
+                continue;
+            }
+            auto shrink = (ggml_backend_buffer_shrink_t) kv_growable_fn(buft_of[ikv], "ggml_backend_buffer_shrink");
+            bool ok = shrink != nullptr;
+            for (ggml_tensor * t : { layer.k, layer.v }) {
+                if (ok && t) {
+                    ok = shrink(t->buffer, t->nb[1]*n*t->ne[2]);
+                }
+            }
+            if (ok) {
+                grown[ikv] = 1;
+            } else {
+                LLAMA_LOG_WARN("%s: layer %u: shrinking the K/V in place failed (VMM), falling back to a new buffer and a copy\n", __func__, layer.il);
+                dyn_vmm[ikv] = 0;
+            }
+        }
+        // their buffers go before the new sections are made: the arena and its VRAM go with its last section
+        for (size_t ib = 0; ib < ctxs_bufs.size(); ++ib) {
+            if (owner[ib] != SIZE_MAX && via_host[owner[ib]] && n_owners[ib] == 1) {
+                ctxs_bufs[ib].second.reset();
+            }
+        }
+        t_free += ggml_time_us() - t1;
+    }
+
+    // growable layout: one arena per device for the K and V of the layers that get a new buffer here (the tested VMM pattern);
+    // the address space is virtual, so it is reserved with room for any chunk alignment (64 MiB per section)
+    struct vmm_arena {
+        void * arena = nullptr;
+        size_t align = 0;
+        size_t next  = 0;
+    };
+    std::map<ggml_backend_buffer_type_t, vmm_arena> arenas;
+    if (!dyn_vmm_off && n_stream == 1 && dyn_max > 0) {
+        std::map<ggml_backend_buffer_type_t, size_t> want;
+        for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+            const auto & layer = layers[ikv];
+            if (on_host[ikv] || flex_kv_layers.count(layer.il) > 0 || grown[ikv]) {
+                continue; // host or flex layer, or a growable layer that grew in place
+            }
+            for (const ggml_tensor * t : { layer.k, layer.v }) {
+                if (t) {
+                    want[buft_of[ikv]] += t->nb[1]*dyn_max*t->ne[2] + (64u << 20);
+                }
+            }
+        }
+        for (const auto & [buft, size] : want) {
+            auto arena_new   = (ggml_backend_vmm_arena_new_t)       kv_growable_fn(buft, "ggml_backend_vmm_arena_new");
+            auto arena_align = (ggml_backend_vmm_arena_alignment_t) kv_growable_fn(buft, "ggml_backend_vmm_arena_alignment");
+            void * arena = arena_new && arena_align ? arena_new(buft, size) : nullptr;
+            if (arena) {
+                arenas[buft] = { arena, arena_align(arena), 0 };
+            }
+        }
+    }
+
+    // the creator reference of the arenas, also on the early returns; they live on with their buffers (the address range and its VRAM go with the last one)
+    struct arenas_guard {
+        std::map<ggml_backend_buffer_type_t, vmm_arena> & arenas;
+        ~arenas_guard() {
+            for (auto & [buft, ar] : arenas) {
+                auto arena_free = (ggml_backend_vmm_arena_free_t) kv_growable_fn(buft, "ggml_backend_vmm_arena_free");
+                if (arena_free) {
+                    arena_free(ar.arena);
+                }
+            }
+        }
+    } arenas_release { arenas };
+
+    // the sections of the layers that get a new growable buffer, then one commit per arena: no access before it
+    std::vector<std::vector<ggml_backend_buffer_ptr>> bufs_section(layers.size());
+    {
+        const int64_t t1 = ggml_time_us();
+        for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+            const auto & layer = layers[ikv];
+            ggml_backend_buffer_type_t buft = buft_of[ikv];
+            auto it_ar = arenas.find(buft);
+            if (it_ar == arenas.end() || grown[ikv] || on_host[ikv] || flex_kv_layers.count(layer.il) > 0) {
+                continue;
+            }
+            auto & ar = it_ar->second;
+            auto arena_buffer = (ggml_backend_vmm_arena_buffer_t) kv_growable_fn(buft, "ggml_backend_vmm_arena_buffer");
+            for (const ggml_tensor * t : { layer.k, layer.v }) {
+                if (!t) {
+                    continue;
+                }
+                const size_t max_bytes = t->nb[1]*dyn_max*t->ne[2];
+                ggml_backend_buffer_ptr b(arena_buffer ? arena_buffer(ar.arena, ar.next, t->nb[1]*n*t->ne[2], max_bytes) : nullptr);
+                ar.next += ar.align*((max_bytes + ar.align - 1)/ar.align);
+                if (!b) {
+                    bufs_section[ikv].clear();
+                    LLAMA_LOG_WARN("%s: layer %u: no growable (VMM) buffer on %s, the K/V grows by copy\n", __func__, layer.il, ggml_backend_buft_name(buft));
+                    break;
+                }
+                bufs_section[ikv].push_back(std::move(b));
+            }
+        }
+        // a failed commit: the sections of that device are freed unaccessed, its layers get ordinary buffers and a copy
+        for (auto & [buft, ar] : arenas) {
+            auto commit = (ggml_backend_vmm_arena_commit_t) kv_growable_fn(buft, "ggml_backend_vmm_arena_commit");
+            if (commit && commit(ar.arena)) {
+                continue;
+            }
+            LLAMA_LOG_ERROR("%s: the new K/V sections on %s could not be committed, falling back to ordinary buffers and a copy\n", __func__, ggml_backend_buft_name(buft));
+            for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+                if (!bufs_section[ikv].empty() && buft_of[ikv] == buft) {
+                    bufs_section[ikv].clear();
+                }
+            }
+        }
+        t_alloc += ggml_time_us() - t1;
+    }
+
+    std::vector<std::pair<ggml_context_ptr, ggml_backend_buffer_ptr>> bufs_new;
+    bufs_new.reserve(2*layers.size());
+    size_t n_copied = 0;
+    const uint32_t n_rows = std::min(n_used, n);
+    for (size_t ikv = 0; ikv < layers.size(); ++ikv) {
+        auto & layer = layers[ikv];
+        ggml_backend_buffer_type_t buft = buft_of[ikv];
+
+        // grown or shrunk in place above: the tensors keep their address and content (no transient copy), only their shape changes
+        if (grown[ikv]) {
+            const int64_t t1 = ggml_time_us();
+            {
+                for (ggml_tensor * t : { layer.k, layer.v }) {
+                    if (!t) {
+                        continue;
+                    }
+                    const size_t old_bytes = ggml_nbytes(t);
+                    t->ne[1] = n;
+                    t->nb[2] = t->nb[1]*n;
+                    t->nb[3] = t->nb[2]*t->ne[2];
+                    if (ggml_nbytes(t) > old_bytes) {
+                        ggml_backend_tensor_memset(t, 0, old_bytes, ggml_nbytes(t) - old_bytes);
+                    }
+                }
+                for (auto * views : { &layer.k_stream, &layer.v_stream }) {
+                    for (ggml_tensor * v : *views) {
+                        if (v) {
+                            v->ne[1] = n;
+                            v->nb[2] = v->nb[1]*n;
+                            v->nb[3] = v->nb[2];
+                        }
+                    }
+                }
+                t_alloc += ggml_time_us() - t1;
+                for (size_t ib = 0; ib < ctxs_bufs.size(); ++ib) {
+                    if (owner[ib] == ikv && n_owners[ib] == 1) {
+                        bufs_new.emplace_back(std::move(ctxs_bufs[ib].first), std::move(ctxs_bufs[ib].second));
+                    }
+                }
+                n_grow++;
+                continue;
+            }
+        }
+
+        const int64_t t1 = ggml_time_us();
+        ggml_init_params params = {
+            /*.mem_size   =*/ size_t(2u*(1 + n_stream)*ggml_tensor_overhead()),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context_ptr ctx(ggml_init(params));
+        if (!ctx) {
+            return false;
+        }
+        kv_layer nl = layer;
+        nl.k_stream.clear();
+        nl.v_stream.clear();
+        for (ggml_tensor ** pt : { &nl.k, &nl.v }) {
+            ggml_tensor * t = *pt;
+            if (!t) {
+                continue;
+            }
+            *pt = ggml_new_tensor_3d(ctx.get(), t->type, t->ne[0], n, t->ne[2]);
+            ggml_set_name(*pt, t->name);
+        }
+        for (uint32_t s = 0; s < n_stream; ++s) {
+            nl.k_stream.push_back(nl.k ? ggml_view_2d(ctx.get(), nl.k, nl.k->ne[0], n, nl.k->nb[1], s*nl.k->nb[2]) : nullptr);
+            nl.v_stream.push_back(nl.v ? ggml_view_2d(ctx.get(), nl.v, nl.v->ne[0], n, nl.v->nb[1], s*nl.v->nb[2]) : nullptr);
+        }
+
+        // on a device with growable buffers: K and V each in a section of the device's arena, sized for the max context
+        std::vector<ggml_backend_buffer_ptr> bufs_layer;
+        if (!bufs_section[ikv].empty()) {
+            size_t ib = 0;
+            for (ggml_tensor * t : { nl.k, nl.v }) {
+                if (!t) {
+                    continue;
+                }
+                ggml_backend_buffer_ptr b(std::move(bufs_section[ikv][ib++]));
+                if (ggml_backend_tensor_alloc(b.get(), t, ggml_backend_buffer_get_base(b.get())) != GGML_STATUS_SUCCESS) {
+                    bufs_layer.clear();
+                    break;
+                }
+                ggml_backend_buffer_clear(b.get(), 0);
+                bufs_layer.push_back(std::move(b));
+            }
+            if (bufs_layer.empty()) {
+                // a failed growable allocation leaves the tensors unallocated
+                for (ggml_tensor * t : { nl.k, nl.v }) {
+                    if (t) {
+                        t->buffer = nullptr;
+                        t->data   = nullptr;
+                    }
+                }
+                LLAMA_LOG_WARN("%s: layer %u: no growable (VMM) buffer on %s, the K/V grows by copy\n", __func__, layer.il, ggml_backend_buft_name(buft));
+            } else {
+                for (uint32_t s = 0; s < n_stream; ++s) {
+                    ggml_backend_view_init(nl.k_stream[s]);
+                    if (nl.v_stream[s]) {
+                        ggml_backend_view_init(nl.v_stream[s]);
+                    }
+                }
+            }
+        }
+        dyn_vmm[ikv] = !bufs_layer.empty();
+        if (bufs_layer.empty()) {
+            ggml_backend_buffer_ptr b(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft));
+            if (via_host[ikv]) {
+                // the old K/V is gone (its range was freed): an ordinary device buffer, else the CPU; stop only if both fail
+                if (b) {
+                    n_lost_vmm++;
+                } else {
+                    ggml_backend_dev_t cpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+                    ggml_backend_buffer_type_t buft_cpu = cpu ? ggml_backend_dev_buffer_type(cpu) : nullptr;
+                    b.reset(buft_cpu ? ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft_cpu) : nullptr);
+                    if (!b) {
+                        GGML_ABORT("layer %u: the K/V was freed for the shrink and no buffer for %u cells could be allocated, "
+                            "neither on %s nor on the CPU", layer.il, n, ggml_backend_buft_name(buft));
+                    }
+                    n_on_cpu++;
+                }
+            }
+            if (!b) {
+                LLAMA_LOG_ERROR("%s: layer %u: failed to allocate %s for %u cells\n", __func__, layer.il, ggml_backend_buft_name(buft), n);
+                return false;
+            }
+            ggml_backend_buffer_clear(b.get(), 0);
+            bufs_layer.push_back(std::move(b));
+            n_copy++;
+        } else {
+            n_vmm_new++;
+        }
+        t_alloc += ggml_time_us() - t1;
+
+        // the used rows of each stream, through the backend (device-internal copy on the same GPU, memcpy on the host)
+        const int64_t t2 = ggml_time_us();
+        for (int i = 0; i < 2 && n_rows > 0; ++i) {
